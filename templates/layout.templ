package templates

templ Layout(title string) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <script src="https://unpkg.com/htmx.org@1.9.10"></script>
        <script src="https://cdn.tailwindcss.com"></script>
        <title>{ title }</title>
        <style>
            body { background-color: #F7F0E6; } /* Sunbaked Cream */
        </style>
    </head>
    <body class="font-sans text-stone-800">
        <!-- Loaded before the page content: both only attach listeners to
             document.body and don't touch page-specific elements, but a
             page's own inline script can run synchronously as soon as it's
             parsed and may call window.offlineSync/etc. immediately (not
             just from an event handler) — so these have to exist first. -->
        <script src="/static/read-cache.js"></script>
        <script src="/static/offline-sync.js"></script>
        { children... }
    </body>
    </html>
}
package templates

// Small linear icons, hand-drawn to match the app's own line weight rather
// than standing in with emoji or an icon-font glyph. Shared across every
// page so the same action always reads the same way (a flag always means
// "next match", a wrench-nut always means pit/mechanical, ...).

templ iconClipboard(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<rect x="5.5" y="4.5" width="13" height="16" rx="2"></rect>
		<path d="M9 4.5V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v.5"></path>
		<path d="M9 12.5l2 2 4-4.5"></path>
	</svg>
}

templ iconFlag(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<path d="M6 21V4"></path>
		<path d="M6 4.5h12l-3.3 4L18 12.5H6"></path>
	</svg>
}

templ iconBars(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<path d="M5 20v-5.5"></path>
		<path d="M12 20V9"></path>
		<path d="M19 20V4.5"></path>
	</svg>
}

templ iconNut(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<polygon points="12,3.5 18.5,7.5 18.5,15.5 12,19.5 5.5,15.5 5.5,7.5"></polygon>
		<circle cx="12" cy="11.5" r="3"></circle>
	</svg>
}

templ iconHome(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<path d="M4 11.5L12 4l8 7.5"></path>
		<path d="M6 9.5V20h12V9.5"></path>
	</svg>
}

// iconLayers is the three-robot / alliance mode: several things at once.
templ iconLayers(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<path d="M12 3.5l8.5 4.5-8.5 4.5-8.5-4.5L12 3.5z"></path>
		<path d="M3.5 12.5L12 17l8.5-4.5"></path>
		<path d="M3.5 16.5L12 21l8.5-4.5"></path>
	</svg>
}

// iconCrosshair is the one-robot / focused mode: watching a single target.
templ iconCrosshair(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="12" cy="12" r="6.5"></circle>
		<circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
		<path d="M12 2.5v3.5"></path>
		<path d="M12 18v3.5"></path>
		<path d="M2.5 12h3.5"></path>
		<path d="M18 12h3.5"></path>
	</svg>
}

templ iconVideo(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<rect x="2.5" y="5" width="14" height="14" rx="2.5"></rect>
		<path d="M21.5 8.5l-5 3.5 5 3.5v-7z"></path>
	</svg>
}

templ iconMic(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<rect x="9.25" y="2.5" width="5.5" height="10.5" rx="2.75"></rect>
		<path d="M5.5 11a6.5 6.5 0 0 0 13 0"></path>
		<path d="M12 17.5V21"></path>
	</svg>
}

// iconTarget is planning for a specific match: aiming at one thing.
templ iconTarget(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="12" cy="12" r="8.5"></circle>
		<circle cx="12" cy="12" r="4.5"></circle>
		<circle cx="12" cy="12" r="0.75" fill="currentColor" stroke="none"></circle>
	</svg>
}

// iconChevronRight is a disclosure indicator, meant to rotate 90deg when its
// <details> is open.
templ iconChevronRight(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M9 5l7 7-7 7"></path>
	</svg>
}

// iconSparkle marks the one AI-generated action (Run analysis): distinct
// from the plain informational icons above.
templ iconSparkle(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="currentColor" stroke="none">
		<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"></path>
		<path d="M19 3.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8L16.5 6l1.8-.7.7-1.8z"></path>
	</svg>
}

package templates

import (
    "strconv"
    "strings"
)

templ Home(events map[string]string, selectedEvent string) {
    @Layout("Vibe Scout | Home") {
        <main class="flex flex-col items-center justify-center min-h-screen px-4 py-8">
            <div class="ps-card max-w-md sm:max-w-lg w-full p-6 sm:p-8 text-center">
                <img src="/static/popcorn-penguins-logo.png" alt="Popcorn Penguins logo" class="w-24 h-24 sm:w-28 sm:h-28 mx-auto mb-3"/>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--ps-ink)] tracking-tight">Vibe Scout</h1>
                <p class="text-sm font-medium text-[var(--ps-muted)] mb-6">Popcorn Penguins, Team 6238</p>

                <!-- Each control sends the chosen event to its own page -->
                <form method="GET" action="/field-scout" class="space-y-5">
                    <div class="text-left">
                        <label for="home-event" class="ps-label">Event</label>
                        <select id="home-event" name="event_key" class="ps-field font-medium">
                            for key, name := range events {
                                <option value={ key } selected?={ key == selectedEvent }>{ name }</option>
                            }
                        </select>
                    </div>

                    <button type="submit" formaction="/field-scout" class="btn btn-primary btn-block btn-lg">
                        @iconClipboard("w-5 h-5")
                        Field Scouting
                    </button>

                    <div class="grid grid-cols-2 gap-3">
                        @homeTile("/next-match", "Next Match")  {
                            @iconFlag("w-6 h-6")
                        }
                        @homeTile("/pick-list", "Pick List") {
                            @iconBars("w-6 h-6")
                        }
                        @homeTile("/pit-scout", "Pit Scouting") {
                            @iconNut("w-6 h-6")
                        }
                        @homeTile("/video-scout", "Video Scouting") {
                            @iconVideo("w-6 h-6")
                        }
                    </div>
                </form>
            </div>
        </main>
    }
}

// homeTile is a secondary home-screen action: an icon over a short label,
// equal weight to its siblings so the one actual primary action (Field
// Scouting, styled separately above) stands out by contrast rather than by
// being one of four identical buttons.
templ homeTile(action string, label string) {
    <button type="submit" formaction={ templ.SafeURL(action) }
        class="btn btn-secondary flex-col gap-1.5 py-4 px-2 h-auto">
        { children... }
        <span class="text-xs font-semibold leading-tight">{ label }</span>
    </button>
}

templ FieldScout(data FieldScoutData) {
    @Layout("Vibe Scout | Field Scouting") {
        <main class="flex flex-col items-center justify-center min-h-screen px-4 py-6">
            <div class="ps-card max-w-md sm:max-w-lg w-full p-6 text-center">
                <h1 class="text-2xl font-extrabold text-[var(--ps-ink)] mb-1 tracking-tight">Field Scouting</h1>
                <p class="text-sm font-medium text-[var(--ps-muted)] mb-4">{ data.EventName }</p>

                <form id="field-form" action="/scout" method="GET" class="space-y-4">
                    <input type="hidden" id="field-event" name="event_key" value={ data.EventKey }/>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="text-left sm:col-span-2">
                            <label for="field-scouter" class="ps-label">Scouter</label>
                            <div class="relative">
                                <input id="field-scouter" type="text" name="scouter" value={ data.ScouterName } required maxlength="40"
                                    placeholder="Your name" autocomplete="off" autocapitalize="words" spellcheck="false"
                                    role="combobox" aria-autocomplete="list" aria-controls="field-scouter-suggest" aria-expanded="false"
                                    class="ps-field font-semibold"/>
                                <ul id="field-scouter-suggest" role="listbox"
                                    class="hidden absolute z-20 left-0 right-0 mt-1 max-h-64 overflow-y-auto bg-[var(--ps-input)] border border-[var(--ps-border)] rounded-lg shadow-lg text-left"></ul>
                            </div>
                            @templ.JSONScript("field-scouters", data.Scouters)
                        </div>

                        <div class="text-left">
                            <label for="field-match" class="ps-label">Match #</label>
                            <input id="field-match" type="number" name="match_num" value={ strconv.Itoa(data.MatchNum) } min="1" required
                                   class="ps-field font-data font-semibold" />
                        </div>
                    </div>

                    <div class="text-left">
                        <span class="ps-label">Scouting mode</span>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="mode-option">
                                <input type="radio" name="mode" value="three" class="sr-only peer" checked?={ data.Mode == "three" }/>
                                <span class="flex flex-col items-center gap-1 p-4 rounded-[var(--ps-radius-md)] border border-[var(--ps-border)] bg-[var(--ps-input)] text-center cursor-pointer transition peer-checked:bg-[var(--ps-red-strong)] peer-checked:border-[var(--ps-red-strong)] peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ps-gold)]">
                                    @iconLayers("w-6 h-6")
                                    <span class="block font-bold text-base">3 robots</span>
                                    <span class="block text-sm opacity-80">Pick an alliance</span>
                                </span>
                            </label>
                            <label class="mode-option">
                                <input type="radio" name="mode" value="one" class="sr-only peer" checked?={ data.Mode == "one" }/>
                                <span class="flex flex-col items-center gap-1 p-4 rounded-[var(--ps-radius-md)] border border-[var(--ps-border)] bg-[var(--ps-input)] text-center cursor-pointer transition peer-checked:bg-[var(--ps-red-strong)] peer-checked:border-[var(--ps-red-strong)] peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ps-gold)]">
                                    @iconCrosshair("w-6 h-6")
                                    <span class="block font-bold text-base">1 robot</span>
                                    <span class="block text-sm opacity-80">Pick a team</span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <!-- Three-robot mode: each alliance button submits the form with its alliance -->
                    <div id="field-alliance-picker" class="hidden text-left"
                        hx-get="/api/match-alliances"
                        hx-include="#field-event, #field-match"
                        hx-trigger="load, input delay:400ms from:#field-match"
                        hx-swap="innerHTML">
                        <p class="text-sm text-[var(--ps-muted)] ml-1">Loading teams…</p>
                    </div>

                    <!-- One-robot mode: each team button submits the form with its team -->
                    <div id="field-team-picker" class="hidden text-left"
                        hx-get="/api/match-teams"
                        hx-include="#field-event, #field-match"
                        hx-trigger="load, input delay:400ms from:#field-match"
                        hx-swap="innerHTML">
                        <p class="text-sm text-[var(--ps-muted)] ml-1">Loading teams…</p>
                    </div>
                </form>
            </div>
            <div class="mt-6 text-center">
                <a href={ templ.SafeURL("/?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
                    @iconHome("w-4 h-4")
                    Home
                </a>
            </div>
            <script>
                (function() {
                    var form = document.getElementById('field-form');
                    var alliancePicker = document.getElementById('field-alliance-picker');
                    var teamPicker = document.getElementById('field-team-picker');
                    function applyMode() {
                        var mode = form.querySelector('input[name=mode]:checked').value;
                        alliancePicker.classList.toggle('hidden', mode !== 'three');
                        teamPicker.classList.toggle('hidden', mode !== 'one');
                    }
                    form.querySelectorAll('input[name=mode]').forEach(function(r) { r.addEventListener('change', applyMode); });
                    applyMode();

                    // ── Scouter name type-ahead ──
                    var input = document.getElementById('field-scouter');
                    var suggest = document.getElementById('field-scouter-suggest');
                    var scouters = JSON.parse(document.getElementById('field-scouters').textContent) || [];
                    var items = [];      // names currently listed
                    var highlighted = -1;

                    // Remember the name on this device so the scouter doesn't retype it
                    if (!input.value) {
                        try { input.value = localStorage.getItem('vibescout.scouter') || ''; } catch (e) {}
                    }
                    form.addEventListener('submit', function() {
                        input.value = input.value.replace(/\s+/g, ' ').trim();
                        try { localStorage.setItem('vibescout.scouter', input.value); } catch (e) {}
                    });

                    function close() {
                        suggest.classList.add('hidden');
                        input.setAttribute('aria-expanded', 'false');
                        highlighted = -1;
                    }
                    function render() {
                        var q = input.value.trim().toLowerCase();
                        var starts = [], contains = [];
                        scouters.forEach(function(n) {
                            var i = n.toLowerCase().indexOf(q);
                            if (i === 0) starts.push(n); else if (i > 0) contains.push(n);
                        });
                        var names = starts.concat(contains).slice(0, 8);
                        var exact = scouters.some(function(n) { return n.toLowerCase() === q; });
                        items = names.slice();
                        suggest.innerHTML = '';
                        names.forEach(function(n) {
                            var li = document.createElement('li');
                            li.setAttribute('role', 'option');
                            li.className = 'px-3 py-2 cursor-pointer font-semibold text-[var(--ps-ink)]';
                            li.textContent = n;
                            suggest.appendChild(li);
                        });
                        if (q !== '' && !exact) {
                            var typed = input.value.replace(/\s+/g, ' ').trim();
                            items.push(typed);
                            var li = document.createElement('li');
                            li.setAttribute('role', 'option');
                            li.className = 'px-3 py-2 cursor-pointer font-semibold text-[var(--ps-ink-soft)] border-t border-[var(--ps-border)]';
                            li.textContent = 'Add scouter "' + typed + '"';
                            suggest.appendChild(li);
                        }
                        if (items.length === 0 || (exact && names.length === 1)) { close(); return; }
                        highlighted = q === '' ? -1 : 0;
                        paint();
                        suggest.classList.remove('hidden');
                        input.setAttribute('aria-expanded', 'true');
                    }
                    function paint() {
                        Array.prototype.forEach.call(suggest.children, function(li, i) {
                            li.classList.toggle('bg-[var(--ps-panel)]', i === highlighted);
                            li.setAttribute('aria-selected', i === highlighted ? 'true' : 'false');
                        });
                    }
                    function pick(i) {
                        input.value = items[i];
                        close();
                    }

                    input.addEventListener('input', render);
                    input.addEventListener('focus', render);
                    input.addEventListener('blur', close);
                    input.addEventListener('keydown', function(e) {
                        var open = !suggest.classList.contains('hidden');
                        if (e.key === 'ArrowDown' && open) {
                            e.preventDefault();
                            highlighted = Math.min(highlighted + 1, items.length - 1);
                            paint();
                        } else if (e.key === 'ArrowUp' && open) {
                            e.preventDefault();
                            highlighted = Math.max(highlighted - 1, 0);
                            paint();
                        } else if (e.key === 'Enter' && open && highlighted >= 0) {
                            e.preventDefault();
                            pick(highlighted);
                        } else if (e.key === 'Escape') {
                            close();
                        }
                    });
                    // mousedown so it fires before the input loses focus
                    suggest.addEventListener('mousedown', function(e) {
                        var li = e.target.closest('li');
                        if (!li) return;
                        e.preventDefault();
                        pick(Array.prototype.indexOf.call(suggest.children, li));
                    });
                })();
            </script>
        </main>
    }
}

templ MatchTeamPicker(teams []PickTeam, matchNum int, errMsg string) {
    <span class="ps-label">{ "Pick a team for match " + strconv.Itoa(matchNum) }</span>
    if errMsg != "" {
        <p class="text-sm text-red-700 ml-2">{ errMsg }</p>
    } else {
        <div class="grid grid-cols-3 gap-2">
            for _, t := range teams {
                <button type="submit" name="team" value={ t.Number } disabled?={ t.IsUs }
                    class={ "relative p-4 rounded-[var(--ps-radius-md)] border-2 font-black text-xl transition active:scale-95 disabled:opacity-50 disabled:active:scale-100",
                        templ.KV("bg-[var(--ps-red-light)] border-[var(--ps-red)] text-[var(--ps-red-strong)]", t.Alliance == "Red" && !t.Soonest && !t.NeedsData),
                        templ.KV("bg-[var(--ps-blue-light)] border-[var(--ps-blue)] text-[var(--ps-blue-strong)]", t.Alliance == "Blue" && !t.Soonest && !t.NeedsData),
                        templ.KV("bg-yellow-100 border-yellow-400 text-[var(--ps-ink)]", t.NeedsData && !t.Soonest),
                        templ.KV("bg-amber-300 border-amber-500 text-[var(--ps-ink)] ring-2 ring-amber-400 ring-offset-1 ring-offset-[var(--ps-surface)]", t.Soonest) }>
                    { t.Number }
                    <span class={ "block text-xs font-bold whitespace-nowrap",
                        templ.KV("text-[var(--ps-red-strong)]", t.Alliance == "Red" && !t.Soonest && !t.NeedsData),
                        templ.KV("text-[var(--ps-blue-strong)]", t.Alliance == "Blue" && !t.Soonest && !t.NeedsData) }>
                        if t.IsUs {
                            Us
                        } else if t.NextWithUs != 0 {
                            { "Q" + strconv.Itoa(t.NextWithUs) }
                        } else {
                            { t.Alliance }
                        }
                    </span>
                    if t.NeedsData {
                        <span class="block text-[10px] font-bold whitespace-nowrap text-yellow-800">
                            { strconv.Itoa(t.Scouted) + " of " + strconv.Itoa(t.PlayedBefore) + " scouted" }
                        </span>
                    }
                </button>
            }
        </div>
        <p class="text-xs text-[var(--ps-muted)] ml-2 mt-2 flex flex-wrap gap-x-4 gap-y-1">
            <span>{ "Q# is the next match with or against " + OurTeam + "." }</span>
            <span class="whitespace-nowrap inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded bg-amber-300 border border-amber-500"></span>
                Soonest
            </span>
            <span class="whitespace-nowrap inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded bg-yellow-100 border border-yellow-400"></span>
                Needs data
            </span>
        </p>
    }
}

templ AlliancePicker(redTeams, blueTeams []string, matchNum int, errMsg string) {
    <span class="ps-label">{ "Pick an alliance for match " + strconv.Itoa(matchNum) }</span>
    if errMsg != "" {
        <p class="text-sm text-red-700 ml-2">{ errMsg }</p>
    } else {
        <div class="grid grid-cols-2 gap-3">
            @allianceButton("Red", redTeams)
            @allianceButton("Blue", blueTeams)
        </div>
    }
}

templ allianceButton(alliance string, teamNums []string) {
    <button type="submit" name="alliance" value={ alliance }
        class={ "p-5 rounded-[var(--ps-radius-md)] border-2 font-black text-lg transition active:scale-95",
            templ.KV("bg-[var(--ps-red-light)] border-[var(--ps-red)] text-[var(--ps-red-strong)]", alliance == "Red"),
            templ.KV("bg-[var(--ps-blue-light)] border-[var(--ps-blue)] text-[var(--ps-blue-strong)]", alliance == "Blue") }>
        <span class="block">{ alliance }</span>
        <span class="block text-base font-bold opacity-80 mt-1">{ strings.Join(teamNums, ", ") }</span>
    </button>
}

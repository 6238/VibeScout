package templates

import (
	"fmt"
	"strconv"
	"strings"
)

// cardAnalysisLegend explains the chips every team-analysis card uses (EPA,
// scouted count, verdict, rank) as a tap-to-open disclosure, not just the
// title= tooltips those chips also carry — a tooltip never fires on a
// touchscreen, and this app is used mostly on phones. The chips keep their
// title attributes too, as a bonus for anyone on a mouse; this is the real,
// touch-reachable copy of the same explanations, written once and shared
// instead of repeated per card.
templ cardAnalysisLegend(includeForecast bool) {
	<details class="group mb-4">
		<summary class="text-xs font-semibold text-[var(--ps-muted)] cursor-pointer select-none list-none flex items-center gap-1.5 w-fit">
			@iconChevronRight("w-3.5 h-3.5 transition-transform group-open:rotate-90")
			What do these mean?
		</summary>
		<dl class="text-xs text-[var(--ps-ink-soft)] bg-[var(--ps-input)] border border-[var(--ps-border-soft)] rounded-[var(--ps-radius-md)] px-3 py-2 mt-2 space-y-1.5">
			<div><dt class="inline font-bold text-[var(--ps-ink)]">EPA —</dt> <dd class="inline">Statbotics' overall points rating from every match a team has played this season. The most reliable single number here.</dd></div>
			<div><dt class="inline font-bold text-[var(--ps-ink)]">EPA top N% —</dt> <dd class="inline">Where that EPA ranks among this event's teams. Lower is better.</dd></div>
			<div><dt class="inline font-bold text-[var(--ps-ink)]">N scouted —</dt> <dd class="inline">Matches our scouts recorded for this team. Green is enough to trust the notes read below; amber ("Low data") isn't — use EPA instead.</dd></div>
			<div><dt class="inline font-bold text-[var(--ps-ink)]">Notes: verdict —</dt> <dd class="inline">The AI's read of our scouting notes only, not a rating of the team. It can disagree with EPA; a big disagreement is flagged.</dd></div>
			<div><dt class="inline font-bold text-[var(--ps-ink)]">Rank —</dt> <dd class="inline">Current qualification rank at this event.</dd></div>
			if includeForecast {
				<div><dt class="inline font-bold text-[var(--ps-ink)]">% to win —</dt> <dd class="inline">Statbotics' predicted chance for this specific match, from our side.</dd></div>
			}
		</dl>
	</details>
}

// verdictClasses returns the Tailwind classes for a verdict badge, color-coded
// from good (green) to bad (red) — a meaningful scale, not decoration, so it
// keeps its own semantic colors rather than the brand palette.
func verdictClasses(verdict string) string {
	switch verdict {
	case "Elite Pick":
		return "bg-green-700 text-white"
	case "Strong Pick":
		return "bg-green-100 text-green-700 border border-green-300"
	case "Average":
		return "bg-amber-100 text-amber-700 border border-amber-300"
	case "Below Average":
		return "bg-orange-100 text-orange-700 border border-orange-300"
	case "Avoid":
		return "bg-red-100 text-red-700 border border-red-300"
	default:
		return "bg-stone-100 text-stone-600 border border-stone-300"
	}
}

// sortEPA is the card's EPA as a string for the page's sort control, or "" when
// unknown so those cards sort last.
func sortEPA(card TeamAnalysisCard) string {
	if !card.HasEPA {
		return ""
	}
	return fmt.Sprintf("%.2f", card.EPA)
}

func lowDataTitle(lowData bool) string {
	if lowData {
		return "Based on too few scouted matches to trust. Lean on EPA."
	}
	return ""
}

// outlookClasses colors the match outlook badge from easy (green) to tough (red).
func outlookClasses(winPct int) string {
	switch {
	case winPct >= 80:
		return "bg-green-700 text-white"
	case winPct >= 60:
		return "bg-green-100 text-green-700 border border-green-300"
	case winPct > 40:
		return "bg-amber-100 text-amber-700 border border-amber-300"
	case winPct > 20:
		return "bg-orange-100 text-orange-700 border border-orange-300"
	}
	return "bg-red-100 text-red-700 border border-red-300"
}

// TLDRBox is our team's strategy in a line or two, shown above everything else.
// It shows nothing when the briefing has no summary.
templ TLDRBox(text string) {
	if text != "" {
		<div class="rounded-[var(--ps-radius-md)] bg-[var(--ps-red-strong)] text-white px-4 py-3 shadow-md">
			<p class="text-xs font-bold text-[var(--ps-gold-soft)] mb-1">Bottom line</p>
			<p class="text-base font-semibold leading-snug">{ text }</p>
		</div>
	}
}

// StrategyBody is a whole briefing for pages that don't lay the summary out
// separately: the summary box, then the rest of it.
templ StrategyBody(s string) {
	{{ tldr, rest := SplitTLDR(s) }}
	if tldr != "" {
		<div class="mb-3">
			@TLDRBox(tldr)
		</div>
	}
	@StrategyText(rest)
}

// StrategyText shows the match briefing with its section labels and team numbers
// picked out, so it can be skimmed on the way to the field.
templ StrategyText(s string) {
	<div class="text-sm text-stone-700 leading-relaxed">
		for _, l := range strategyLines(s) {
			if l.Blank {
				<div class="h-2"></div>
			} else if l.Section {
				<p class="mt-3 first:mt-0"><span class="font-bold text-[var(--ps-ink)] text-sm">{ l.Label }</span> { l.Text }</p>
			} else if l.Label != "" {
				<p class="ml-3"><span class="font-bold text-[var(--ps-ink)]">{ l.Label }:</span> { l.Text }</p>
			} else {
				<p>{ l.Text }</p>
			}
		}
	</div>
}

// panelID is the element id for a card's notes panels. Cards in the next-match
// section share team numbers with the full list, so the section is part of the id.
func panelID(card TeamAnalysisCard, kind string) string {
	return card.Section + kind + "-" + card.TeamNumber
}

// teamCardTargetID is the element id of a whole card, so the clarification
// form (nested inside a notes panel, itself nested inside the card) can
// target the card for a full refresh after it saves.
func teamCardTargetID(section, teamNum string) string {
	return "team-card-" + section + teamNum
}

// NextMatchPage is our next qualification match: the win chance, the plan and a
// summary of each team in it. The content loads from /api/next-match.
templ NextMatchPage(data EventPageData) {
	@Layout("Vibe Scout | Next Match") {
		<main class="container mx-auto px-4 py-8">
			<div class="max-w-4xl mx-auto">
				<p class="text-sm font-medium text-[var(--ps-muted)] mb-3 text-center">{ data.EventName }</p>
				<div class="ps-card p-4 mb-4">
					@cardAnalysisLegend(true)
				</div>
				<div
					id="next-match"
					hx-get={ "/api/next-match?event_key=" + data.EventKey }
					hx-trigger="load"
					hx-swap="innerHTML"
					class="mb-6">
					<div class="ps-card p-6 text-center text-[var(--ps-muted)] font-semibold animate-pulse">
						Loading next match…
					</div>
				</div>
			</div>

			<div class="mt-6 flex flex-wrap gap-2 justify-center">
				<a href={ templ.SafeURL("/pick-list?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
					@iconBars("w-4 h-4")
					Pick list
				</a>
				<a href={ templ.SafeURL("/match-planner?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
					@iconTarget("w-4 h-4")
					Plan a different match
				</a>
				<a href={ templ.SafeURL("/?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
					@iconHome("w-4 h-4")
					Home
				</a>
			</div>
		</main>
	}
}

// PickListPage is the ranked list of every team with its summary card, for
// deciding who to pick.
templ PickListPage(data EventPageData) {
	@Layout("Vibe Scout | Pick List") {
		<main class="container mx-auto px-4 py-8">
			<div class="max-w-4xl mx-auto">
				<div class="ps-card p-6 mb-6">
					<h1 class="text-2xl font-extrabold text-[var(--ps-ink)] mb-1 text-center tracking-tight">Pick list</h1>
					<p class="text-sm font-medium text-[var(--ps-muted)] mb-4 text-center">{ data.EventName }</p>

					<form
						hx-post="/api/run-analysis"
						hx-target="#analysis-results"
						hx-swap="innerHTML">
						<input type="hidden" id="event-key" name="event_key" value={ data.EventKey }/>
						<button type="submit" class="btn btn-primary btn-block btn-lg">
							@iconSparkle("w-5 h-5")
							Run analysis
						</button>
					</form>

					<div class="mt-4 grid sm:grid-cols-2 gap-4">
						<div>
							<label for="team-search" class="ps-label">Search teams</label>
							<input id="team-search" type="search" autocomplete="off" placeholder="Team number or keyword in scout / pit notes"
								class="ps-field"/>
							<p id="team-search-status" class="text-xs text-[var(--ps-muted)] mt-1"></p>
						</div>

						<div>
							<label for="team-sort" class="ps-label">Sort teams</label>
							<select id="team-sort" class="ps-field">
								<option value="epa">EPA (best first)</option>
								<option value="team">Team number</option>
								<option value="reliability">Reliability (scouted)</option>
								<option value="scoring">Scoring (scouted)</option>
								<option value="matches">Matches scouted</option>
							</select>
							<p class="text-xs text-[var(--ps-muted)] mt-1">EPA over every match; scouted ratings are only as good as matches scouted.</p>
						</div>
					</div>

					@cardAnalysisLegend(false)
				</div>

				<div id="analysis-results"></div>
			</div>
			<script>
				(function() {
					var input = document.getElementById('team-search');
					var status = document.getElementById('team-search-status');
					var matches = null; // null = no filter; otherwise a Set of team numbers
					var timer = null;
					var seq = 0;

					function applyFilter() {
						var cards = document.querySelectorAll('#analysis-results [data-team]');
						var shown = 0;
						cards.forEach(function(card) {
							var show = matches === null || matches.has(card.dataset.team);
							card.style.display = show ? '' : 'none';
							if (show) shown++;
						});
						if (matches === null) {
							status.textContent = '';
						} else if (cards.length === 0) {
							status.textContent = 'Run analysis to see team cards.';
						} else {
							status.textContent = shown + ' of ' + cards.length + ' teams match';
						}
					}

					function search() {
						var q = input.value.trim();
						if (q === '') { matches = null; applyFilter(); return; }
						var eventKey = document.getElementById('event-key').value;
						var mySeq = ++seq;
						fetch('/api/search-teams?event_key=' + encodeURIComponent(eventKey) + '&q=' + encodeURIComponent(q))
							.then(function(r) { return r.json(); })
							.then(function(teams) {
								if (mySeq !== seq) return; // a newer search is in flight
								matches = new Set(teams);
								applyFilter();
							})
							.catch(function() { status.textContent = 'Search failed.'; });
					}

					input.addEventListener('input', function() {
						clearTimeout(timer);
						timer = setTimeout(search, 250);
					});
					var sortSel = document.getElementById('team-sort');
					function num(el, key) {
						var v = parseFloat(el.dataset[key]);
						return isNaN(v) ? null : v;
					}
					function applySort() {
						var list = document.querySelector('#analysis-results .space-y-4');
						if (!list) return;
						var key = sortSel.value;
						var items = Array.prototype.slice.call(list.children);
						// Cards still loading have no data yet, so they stay at the end.
						var loaded = items.filter(function(el) { return !el.dataset.teamSlot; });
						var pending = items.filter(function(el) { return el.dataset.teamSlot; });
						loaded.sort(function(a, b) {
							var av = num(a, key);
							var bv = num(b, key);
							if (av === null && bv === null) return num(a, 'team') - num(b, 'team');
							if (av === null) return 1;
							if (bv === null) return -1;
							if (av === bv) return num(a, 'team') - num(b, 'team');
							return key === 'team' ? av - bv : bv - av;
						});
						loaded.concat(pending).forEach(function(el) { list.appendChild(el); });
					}
					sortSel.addEventListener('change', applySort);

					// Keep the filter and sort applied as team cards load in
					document.body.addEventListener('htmx:afterSettle', function() {
						applyFilter();
						applySort();
					});
				})();
			</script>

			<div class="mt-6 flex flex-wrap gap-2 justify-center">
				<a href={ templ.SafeURL("/next-match?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
					@iconFlag("w-4 h-4")
					Next match
				</a>
				<a href={ templ.SafeURL("/?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
					@iconHome("w-4 h-4")
					Home
				</a>
			</div>
		</main>
	}
}

templ NextMatchSection(d NextMatchData) {
	if d.MatchNum == 0 {
		<div class="ps-card p-6 text-center">
			<h2 class="text-lg font-extrabold text-[var(--ps-ink)]">Next match</h2>
			if d.PlanError != "" {
				<p class="text-sm text-red-700 mt-2">{ d.PlanError }</p>
			} else {
				<p class="text-sm text-[var(--ps-muted)] mt-2">{ "Team " + OurTeam + " has no unplayed qualification matches on the schedule." }</p>
			}
		</div>
	} else {
		<div class="ps-card p-6 space-y-4">
			{{ tldr, rest := SplitTLDR(d.Plan.Strategy) }}
			<div class="flex flex-wrap justify-between items-baseline gap-2">
				<h2 class="text-xl font-extrabold text-[var(--ps-ink)] tracking-tight">{ "Next match: " + d.Label }</h2>
				<span class="text-sm font-semibold text-[var(--ps-muted)]">{ "We're on " + d.Plan.OurAlliance }</span>
			</div>

			@TLDRBox(tldr)

			if d.HasPrediction {
				<div class="ps-panel p-4" title="Statbotics' forecast for this match, from our side">
					<div class="flex flex-wrap justify-between items-center gap-2 mb-2">
						<span class={ "text-sm font-bold px-3 py-1 rounded-full", outlookClasses(d.WinPct) }>{ d.Outlook }</span>
						<span class="text-2xl font-extrabold text-[var(--ps-ink)]">{ fmt.Sprintf("%d%%", d.WinPct) } <span class="text-xs font-semibold text-[var(--ps-muted)]">to win</span></span>
					</div>
					<div class="h-2 rounded-full overflow-hidden bg-stone-200">
						<div class="h-full rounded-full bg-[var(--ps-gold-strong)]" style={ fmt.Sprintf("width: %d%%", d.WinPct) }></div>
					</div>
					<p class="text-xs font-medium text-[var(--ps-muted)] mt-2">
						{ fmt.Sprintf("Predicted score: %.0f–%.0f (us–them), from Statbotics.", d.OurScore, d.TheirScore) }
					</p>
				</div>
			}

			<div class="ps-panel p-4">
				<p class="text-xs font-bold text-[var(--ps-muted)] mb-2">Strategy</p>
				if d.PlanError != "" {
					<p class="text-sm font-semibold text-[var(--ps-muted)] bg-[var(--ps-surface)] border border-[var(--ps-border)] rounded-lg px-3 py-2">
						{ d.PlanError }
					</p>
				} else {
					@StrategyText(rest)
				}
			</div>

			<div>
				<h3 class="text-sm font-bold text-[var(--ps-muted)] mb-2">Partners</h3>
				<div class="space-y-4">
					for _, t := range d.Partners {
						@nextMatchSlot(d.EventKey, t)
					}
				</div>
			</div>
			<div>
				<h3 class="text-sm font-bold text-[var(--ps-muted)] mb-2">Opponents</h3>
				<div class="space-y-4">
					for _, t := range d.Opponents {
						@nextMatchSlot(d.EventKey, t)
					}
				</div>
			</div>
		</div>
	}
}

// nextMatchSlot is a placeholder that loads one team's summary card. It has no
// data-team-slot, so it doesn't count toward the full-list progress bar.
templ nextMatchSlot(eventKey string, team string) {
	<div
		hx-get={ "/api/analyze-team?section=next-&event_key=" + eventKey + "&team_number=" + team }
		hx-trigger="load"
		hx-swap="outerHTML"
		class="ps-card p-5 animate-pulse">
		<div class="h-6 w-28 bg-[var(--ps-border)]/27 rounded mb-3"></div>
		<div class="h-4 bg-[var(--ps-border)]/27 rounded w-full mb-2"></div>
		<div class="h-4 bg-[var(--ps-border)]/27 rounded w-3/4"></div>
	</div>
}

templ GeminiAnalysisProgressContainer(teams []string, eventKey string) {
	if len(teams) == 0 {
		<div class="text-center py-12 text-[var(--ps-muted)]">
			<p class="text-xl font-bold">No scouting data found for this event.</p>
			<p class="text-sm mt-2">Scout some matches first, then run analysis.</p>
		</div>
	} else {
		<div id="progress-container" data-total={ strconv.Itoa(len(teams)) } class="mb-6 ps-card p-4">
			<div class="flex justify-between items-center mb-2">
				<span class="text-sm font-bold text-[var(--ps-ink)]">Analyzing teams</span>
				<span id="progress-text" class="text-sm font-bold text-[var(--ps-ink)] font-data">0 / { strconv.Itoa(len(teams)) }</span>
			</div>
			<div class="h-2.5 rounded-full overflow-hidden bg-[var(--ps-border)]/33">
				<div id="progress-bar" class="h-full rounded-full bg-[var(--ps-gold-strong)] transition-all duration-300" style="width: 0%"></div>
			</div>
		</div>
		<div class="space-y-4">
			for _, team := range teams {
				<div
					id={ "slot-" + team }
					data-team-slot="true"
					data-team={ team }
					hx-get={ "/api/analyze-team?event_key=" + eventKey + "&team_number=" + team }
					hx-trigger="load"
					hx-swap="outerHTML"
					class="ps-card p-5 animate-pulse">
					<div class="flex justify-between items-center mb-4">
						<div class="h-6 w-28 bg-[var(--ps-border)]/27 rounded"></div>
						<div class="h-5 w-16 bg-[var(--ps-border)]/27 rounded-full"></div>
					</div>
					<div class="grid grid-cols-3 gap-3 mb-4">
						<div class="h-8 bg-[var(--ps-border)]/27 rounded"></div>
						<div class="h-8 bg-[var(--ps-border)]/27 rounded"></div>
						<div class="h-8 bg-[var(--ps-border)]/27 rounded"></div>
					</div>
					<div class="h-4 bg-[var(--ps-border)]/27 rounded w-full mb-2"></div>
					<div class="h-4 bg-[var(--ps-border)]/27 rounded w-3/4"></div>
				</div>
			}
		</div>
		<script>
			(function() {
				var container = document.getElementById('progress-container');
				var total = parseInt(container.dataset.total, 10);
				var done = 0;
				document.body.addEventListener('htmx:afterSwap', function(e) {
					if (e.detail.target && e.detail.target.dataset && e.detail.target.dataset.teamSlot) {
						done++;
						var pct = Math.round(done / total * 100);
						document.getElementById('progress-bar').style.width = pct + '%';
						document.getElementById('progress-text').textContent = done + ' / ' + total;
						if (done >= total) {
							setTimeout(function() {
								var pc = document.getElementById('progress-container');
								if (pc) pc.style.display = 'none';
							}, 1500);
						}
					}
				});
			})();
		</script>
	}
}

// pitProfileRow shows what the team told us in the pit. It is styled quietly and
// labeled self-reported because it counts for less than what we saw in matches.
templ pitProfileRow(p PitProfile) {
	<div class="mb-4 rounded-[var(--ps-radius-md)] bg-[var(--ps-surface)]/60 border border-dashed border-[var(--ps-border)] px-3 py-2">
		<div class="flex flex-wrap items-center gap-1.5 mb-1">
			<span class="text-xs font-semibold text-[var(--ps-muted)]" title="From the pit interview. The team's own claims, weighted less than match scouting.">Pit (self-reported)</span>
			if p.Archetype != "" {
				<span class="ps-chip">{ p.Archetype }</span>
			}
			if p.Role != "" {
				<span class="ps-chip">{ "Prefers " + p.Role }</span>
			}
		</div>
		<dl class="grid sm:grid-cols-2 gap-x-4 gap-y-0.5 text-xs text-stone-700 leading-snug">
			@pitFact("Strength", p.Strength)
			@pitFact("Biggest problem", p.Problem)
			@pitFact("Wants partner", p.Partner)
			@pitFact("Back-to-back", p.Turnaround)
			@pitFact("Driver safety", p.Safety)
		</dl>
	</div>
}

templ pitFact(label string, value string) {
	if value != "" {
		<div>
			<dt class="inline font-semibold text-[var(--ps-ink-soft)]">{ label }: </dt>
			<dd class="inline">{ value }</dd>
		</div>
	}
}

templ SingleTeamAnalysisCard(card TeamAnalysisCard) {
	<div
		id={ teamCardTargetID(card.Section, card.TeamNumber) }
		data-team={ card.TeamNumber }
		data-epa={ sortEPA(card) }
		data-matches={ strconv.Itoa(card.Matches) }
		data-scoring={ strconv.Itoa(card.Scoring) }
		data-reliability={ strconv.Itoa(card.Reliability) }
		class="ps-card p-5">
		<!-- Header row -->
		<div class="flex flex-wrap justify-between items-center gap-2 mb-4">
			<div class="flex flex-wrap items-baseline gap-2">
				<h2 class="text-xl font-extrabold text-[var(--ps-ink)] whitespace-nowrap">Team { card.TeamNumber }</h2>
				if card.HasEPA {
					<span class="ps-chip" title="Statbotics total points EPA this season">
						{ fmt.Sprintf("EPA %.1f", card.EPA) }
					</span>
				}
				if card.HasEPAPct {
					<span class="ps-chip" title="Where this team's EPA ranks among the teams at this event">
						{ fmt.Sprintf("EPA top %d%%", card.EPATopPct) }
					</span>
				}
				if card.Matches > 0 {
					<span class={ "text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap border",
						templ.KV("bg-amber-100 text-amber-700 border-amber-300", card.LowData),
						templ.KV("bg-green-100 text-green-700 border-green-300", !card.LowData) }
						title="Matches our scouts recorded for this team. The scouting read below rests on these.">
						{ fmt.Sprintf("%d scouted", card.Matches) }
					</span>
				}
				if card.LowData {
					<span class="text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap bg-stone-100 text-stone-600 border border-stone-300" title="Fewer than 3 scouted matches, so no verdict is shown. Use EPA.">
						Low data
					</span>
				} else if card.Verdict != "" {
					<span class={ "text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap", verdictClasses(card.Verdict) }
						title="The AI's read of our scouting notes only. It is not a rating of the team.">
						{ "Notes: " + card.Verdict }
					</span>
				}
				if card.HasRank {
					<span class="ps-chip-gold" title="Current qualification rank at this event">
						{ fmt.Sprintf("Rank %d", card.Rank) }
					</span>
				}
			</div>
			if len(card.RecentMatches) > 0 {
				<div class="flex flex-wrap items-center gap-1.5">
					<span class="text-xs font-semibold text-[var(--ps-muted)] whitespace-nowrap">Latest matches</span>
					for _, m := range card.RecentMatches {
						<span class="inline-flex rounded-full overflow-hidden border border-[var(--ps-border)]">
							<a href={ templ.SafeURL(m.URL) } target="_blank" rel="noopener noreferrer"
								title={ "Match " + m.Label + " on The Blue Alliance" }
								class="text-xs font-bold px-2.5 py-1 whitespace-nowrap bg-[var(--ps-input)] text-[var(--ps-ink)] hover:bg-[var(--ps-panel)] transition">
								{ m.Label }
							</a>
							if m.HasWatch {
								<a href={ templ.SafeURL(m.WatchURL) } target="_blank" rel="noopener noreferrer"
									title={ "Watch " + m.Label + " on YouTube at the moment it happened — no waiting for the edited match video" }
									class="text-xs font-bold px-2 py-1 whitespace-nowrap bg-[var(--ps-red-strong)] text-white hover:bg-[var(--ps-red-deep)] transition border-l border-[var(--ps-ink)]/20">
									▶
								</a>
							}
						</span>
					}
				</div>
			}
			<div class="flex flex-wrap items-center gap-2">
				if card.FromCache {
					<span class="ps-chip">Cached</span>
				} else {
					<span class="ps-chip ps-chip-gold">Fresh</span>
				}
				if card.HasNotes {
					<button
						class="btn btn-ghost btn-sm"
						hx-get={ "/api/team-notes?event_key=" + card.EventKey + "&team_number=" + card.TeamNumber + "&section=" + card.Section }
						hx-target={ "#" + panelID(card, "notes") }
						hx-swap="innerHTML"
						hx-on::before-request="var t = event.detail.target; if (t.innerHTML.trim() !== '') { t.innerHTML = ''; event.preventDefault(); }">
						View notes
					</button>
				}
				if card.HasPitNotes {
					<button
						class="btn btn-ghost btn-sm"
						hx-get={ "/api/team-pit-notes?team_number=" + card.TeamNumber + "&event_key=" + card.EventKey + "&section=" + card.Section }
						hx-target={ "#" + panelID(card, "pit-notes") }
						hx-swap="innerHTML"
						hx-on::before-request="var t = event.detail.target; if (t.innerHTML.trim() !== '') { t.innerHTML = ''; event.preventDefault(); }">
						Pit notes
					</button>
				}
			</div>
		</div>

		if card.Disagreement != "" {
			<p class="text-xs font-semibold text-amber-800 bg-amber-100 border border-amber-300 rounded-lg px-3 py-2 mb-3">
				⚠ { card.Disagreement }
			</p>
		}
		if card.ChecklistN > 0 {
			<p class="text-xs font-semibold text-[var(--ps-ink-soft)] mb-3">
				{ fmt.Sprintf("Checklist (%d matches): broke %d, played defense %d, was defended %d.", card.ChecklistN, card.BrokeN, card.DefenseN, card.WasDefendedN) }
			</p>
		}

		if card.Pit.Has {
			@pitProfileRow(card.Pit)
		}

		<!-- Score bars: not shown at all when analysis failed outright - a
		     dimmed-but-still-numeric 0/10 would read as a real, if weak,
		     score. LowData is different: there IS a real (if sparse)
		     verdict there, just dimmed to say so plainly. -->
		if card.Error == "" {
			<div class={ "grid grid-cols-3 gap-3 mb-4", templ.KV("opacity-50", card.LowData) }
				title={ lowDataTitle(card.LowData) }>
				@scoreBar("Scoring", card.Scoring, "var(--ps-gold)", "var(--ps-gold-strong)")
				@scoreBar("Reliability", card.Reliability, "#A8D5A2", "#4CAF50")
				@defenseBar(card.Defense)
			</div>
		}

		<!-- Verdict breakdown -->
		if card.Error != "" {
			<p
				class="text-sm font-semibold text-[var(--ps-muted)] bg-[var(--ps-panel)] border border-[var(--ps-border)] rounded-lg px-3 py-2"
				title={ card.Error }
			>
				Analysis isn't available right now. Use EPA and the scouting notes below instead.
			</p>
		} else {
			<div class="space-y-3">
				<div class="grid sm:grid-cols-2 gap-3">
					<div>
						<p class="text-xs font-bold text-[var(--ps-muted)] mb-0.5">Shooting</p>
						<p class="text-sm text-stone-700 leading-snug">{ card.Shooting }</p>
					</div>
					<div>
						<p class="text-xs font-bold text-[var(--ps-muted)] mb-0.5">Driving</p>
						<p class="text-sm text-stone-700 leading-snug">{ card.Driving }</p>
					</div>
					<div>
						<p class="text-xs font-bold text-[var(--ps-muted)] mb-0.5">Auto</p>
						<p class="text-sm text-stone-700 leading-snug">{ card.Auto }</p>
					</div>
					<div>
						<p class="text-xs font-bold text-[var(--ps-muted)] mb-0.5">Failures</p>
						<p class="text-sm text-stone-700 leading-snug">{ card.Failures }</p>
					</div>
				</div>
				<div>
					<p class="text-xs font-bold text-[var(--ps-muted)] mb-0.5">Recommendation</p>
					<p class="text-sm text-stone-700 leading-snug">{ card.Recommendation }</p>
				</div>
			</div>
		}

		<!-- Notes (loaded on demand, or pre-filled after a clarification refresh) -->
		<div id={ panelID(card, "notes") }>
			if card.OpenNotesPanel != nil {
				@card.OpenNotesPanel
			}
		</div>
		<div id={ panelID(card, "pit-notes") }>
			if card.OpenPitNotesPanel != nil {
				@card.OpenPitNotesPanel
			}
		</div>
	</div>
}

templ closePanelButton() {
	<button type="button" class="btn btn-ghost btn-sm"
		onclick="this.closest('[data-notes-panel]').parentElement.innerHTML = ''">
		Close
	</button>
}

templ TeamNotesPanel(eventKey, teamNum, section string, groups []TeamNoteGroup, clarifications []Clarification) {
	if len(groups) == 0 {
		<div data-notes-panel class="ps-panel-in mt-4 flex justify-between items-center">
			<p class="text-sm text-[var(--ps-muted)] italic">No scouting notes found.</p>
			@closePanelButton()
		</div>
	} else {
		<div data-notes-panel class="ps-panel-in mt-4 border-t border-[var(--ps-border)] pt-4 space-y-4">
			<div class="flex justify-between items-center">
				<h3 class="text-sm font-bold text-[var(--ps-muted)]">Scout notes</h3>
				@closePanelButton()
			</div>
			for _, group := range groups {
				@teamNoteGroupCard(group)
			}
			@clarificationsList(eventKey, teamNum, section, "field", clarifications)
			@clarificationForm(eventKey, teamNum, section, "field")
		</div>
	}
}

// teamNoteGroupCard is every note for one match, under a header linking back
// to that match — TBA's own video once it's posted, otherwise a timestamped
// moment in the event's livestream — plus the score, partners and opponents,
// so a disputed or surprising note can be checked against what actually
// happened.
templ teamNoteGroupCard(group TeamNoteGroup) {
	<div class="ps-panel px-4 py-3">
		<div class="flex justify-between items-baseline gap-2 flex-wrap">
			<span class="text-sm font-bold text-[var(--ps-ink)]">Match { fmt.Sprintf("%d", group.MatchNum) }</span>
			<div class="flex items-center gap-2 text-xs font-semibold text-[var(--ps-ink-soft)]">
				if group.ScoreText != "" {
					<span>{ group.ScoreText }</span>
				}
				if group.Partners != "" {
					<span class="text-[var(--ps-muted)]">with { group.Partners }</span>
				}
				if group.Opponents != "" {
					<span class="text-[var(--ps-muted)]">vs { group.Opponents }</span>
				}
				if group.HasWatch {
					<a href={ templ.SafeURL(group.WatchURL) } target="_blank" rel="noopener"
						class="text-[var(--ps-ink)] bg-white border border-[var(--ps-border)] rounded-full px-2 py-0.5 hover:bg-[var(--ps-input)]">▶ Watch</a>
				}
			</div>
		</div>
		if len(group.Conflicts) > 0 {
			<p class="text-xs font-semibold text-red-700 mt-1.5">⚠ Scouts disagreed on { strings.Join(group.Conflicts, ", ") } — check the video above.</p>
		}
		<div class="mt-2 space-y-2">
			for _, note := range group.Notes {
				@teamNoteCard(note, len(group.Notes) > 1)
			}
		</div>
	</div>
}

templ teamNoteCard(note TeamNote, showMode bool) {
	<div class="bg-[var(--ps-input)]/70 rounded-[var(--ps-radius-sm)] px-3 py-2 border border-[var(--ps-border-soft)]">
		<div class="flex justify-between items-baseline gap-2">
			if note.AIGenerated {
				<span class="text-xs font-semibold text-[var(--ps-muted)]">Gemini (video)</span>
			} else if note.ScouterName != "" {
				<span class="text-xs font-semibold text-[var(--ps-muted)] truncate">{ note.ScouterName }</span>
			} else {
				<span></span>
			}
			if showMode && !note.AIGenerated {
				if note.SingleTeam {
					<span class="text-xs font-semibold text-[var(--ps-ink-soft)]">Focused on this robot</span>
				} else {
					<span class="text-xs font-semibold text-[var(--ps-muted)]">Watching multiple robots</span>
				}
			}
		</div>
		if note.HasChecklist {
			<div class="flex flex-wrap gap-1.5 mt-2">
				@checklistChip("Broke", note.Broke, true)
				@checklistChip("Played defense", note.PlayedDefense, false)
				@checklistChip("Was defended", note.WasDefended, false)
				if note.AutoType != "" {
					<span class="ps-chip">{ "Auto: " + note.AutoType }</span>
				}
			</div>
		}
		if note.Notes != "" {
			<p class="text-sm text-stone-700 mt-1 whitespace-pre-wrap">{ note.Notes }</p>
		}
	</div>
}

// checklistChip shows a yes/no answer; bad answers ("broke: yes") are red.
templ checklistChip(label string, yes bool, yesIsBad bool) {
	<span class={ "text-xs font-bold px-2 py-0.5 rounded-full border",
		templ.KV("bg-red-100 text-red-700 border-red-300", yes && yesIsBad),
		templ.KV("bg-[var(--ps-gold-pale)] text-[var(--ps-ink)] border-[var(--ps-gold-strong)]", yes && !yesIsBad),
		templ.KV("bg-transparent text-[var(--ps-muted)] border-[var(--ps-border)]", !yes) }>
		{ label }:
		if yes {
			Yes
		} else {
			No
		}
	</span>
}

templ TeamPitNotesPanel(eventKey, teamNum, section string, notes []PitNote, clarifications []Clarification) {
	if len(notes) == 0 {
		<div data-notes-panel class="ps-panel-in mt-4 flex justify-between items-center">
			<p class="text-sm text-[var(--ps-muted)] italic">No pit scouting notes found.</p>
			@closePanelButton()
		</div>
	} else {
		<div data-notes-panel class="ps-panel-in mt-4 border-t border-[var(--ps-border)] pt-4 space-y-3">
			<div class="flex justify-between items-center">
				<h3 class="text-sm font-bold text-[var(--ps-muted)]">Pit scouting</h3>
				@closePanelButton()
			</div>
			for _, note := range notes {
				<div class="ps-panel px-4 py-3">
					<span class="text-xs font-semibold text-[var(--ps-ink-soft)]">{ note.CreatedAt }</span>
					<p class="text-sm text-stone-700 mt-1 whitespace-pre-wrap">{ note.Summary }</p>
				</div>
			}
			@clarificationsList(eventKey, teamNum, section, "pit", clarifications)
			@clarificationForm(eventKey, teamNum, section, "pit")
		</div>
	}
}

// clarificationsList shows every clarification the strategy team has added on
// top of the notes above, oldest first — visible to everyone, never a silent
// edit, so a later reader can spot two clarifications that actually
// contradict each other and go fix the underlying note directly instead.
// Anyone can add a clarification with no login, so anyone can also delete
// one — e.g. once the note it was about has been edited directly and the
// clarification is now stale.
templ clarificationsList(eventKey, teamNum, section, noteType string, items []Clarification) {
	if len(items) > 0 {
		<div class="space-y-1.5">
			<h4 class="text-xs font-bold text-[var(--ps-muted)]">Clarifications</h4>
			for _, c := range items {
				<div class="flex items-start justify-between gap-2 ps-chip-gold rounded-[var(--ps-radius-sm)] px-3 py-1.5">
					<p class="text-sm text-[var(--ps-ink)] font-normal">
						{ c.Text }
						<span class="text-xs text-[var(--ps-muted)]">
							—
							if c.Author != "" {
								{ c.Author },
							}
							{ c.When }
						</span>
					</p>
					<form
						hx-post="/api/delete-clarification"
						hx-target={ "#" + teamCardTargetID(section, teamNum) }
						hx-swap="outerHTML"
						hx-confirm="Delete this clarification? This can't be undone.">
						<input type="hidden" name="id" value={ strconv.Itoa(c.ID) }/>
						<input type="hidden" name="event_key" value={ eventKey }/>
						<input type="hidden" name="team_number" value={ teamNum }/>
						<input type="hidden" name="section" value={ section }/>
						<input type="hidden" name="note_type" value={ noteType }/>
						<button type="submit" title="Delete this clarification"
							class="shrink-0 text-xs font-bold text-[var(--ps-red-strong)] hover:text-[var(--ps-red-deep)] px-1">✕</button>
					</form>
				</div>
			}
		</div>
	}
}

// clarificationForm lets anyone add context the AI misread — e.g. "2.5
// cycles" meaning during auto, not the whole match — right where the
// misread note is, instead of hunting down and editing the original scouting
// entry. It's appended after the notes it clarifies (see clarificationsBlock
// on the server), never rewriting the original scout's words, and saving
// refreshes the whole card above so the fix shows up immediately.
templ clarificationForm(eventKey, teamNum, section, noteType string) {
	<form
		class="flex flex-col gap-2 pt-1"
		hx-post="/api/add-clarification"
		hx-target={ "#" + teamCardTargetID(section, teamNum) }
		hx-swap="outerHTML">
		<input type="hidden" name="event_key" value={ eventKey }/>
		<input type="hidden" name="team_number" value={ teamNum }/>
		<input type="hidden" name="section" value={ section }/>
		<input type="hidden" name="note_type" value={ noteType }/>
		<label class="text-xs font-bold text-[var(--ps-muted)]">
			if noteType == "pit" {
				Clarify these pit notes for the AI
			} else {
				Clarify these match notes for the AI
			}
		</label>
		<textarea name="text" rows="2" required
			placeholder={ `e.g. "2.5 cycles" means during auto, not the whole match` }
			class="ps-field text-sm resize-none"></textarea>
		<div class="flex flex-wrap gap-2 items-center">
			<input type="text" name="author" placeholder="Your name (optional)"
				class="ps-field text-sm flex-1 min-w-[8rem]"/>
			<button type="submit" class="btn btn-primary btn-sm">
				Save and refresh
			</button>
		</div>
	</form>
}

templ GeminiAnalysisResults(cards []TeamAnalysisCard) {
	if len(cards) == 0 {
		<div class="text-center py-12 text-[var(--ps-muted)]">
			<p class="text-xl font-bold">No scouting data found for this event.</p>
			<p class="text-sm mt-2">Scout some matches first, then run analysis.</p>
		</div>
	} else {
		<div class="space-y-4">
			for _, card := range cards {
				@SingleTeamAnalysisCard(card)
			}
		</div>
	}
}

templ scoreBar(label string, score int, trackColor string, fillColor string) {
	<div>
		<div class="flex justify-between items-center mb-1">
			<span class="text-xs font-semibold text-[var(--ps-muted)]">{ label }</span>
			<span class="text-sm font-bold text-[var(--ps-ink)] font-data">{ strconv.Itoa(score) }/10</span>
		</div>
		<div class="h-2 rounded-full overflow-hidden" style={ fmt.Sprintf("background-color: color-mix(in srgb, %s 20%%, transparent)", trackColor) }>
			<div class="h-full rounded-full origin-left" data-reveal style={ fmt.Sprintf("width: %d%%; background-color: %s; transform: scaleX(0)", score*10, fillColor) }></div>
		</div>
	</div>
}

templ defenseBar(score int) {
	<div>
		<div class="flex justify-between items-center mb-1">
			<span class="text-xs font-semibold text-[var(--ps-muted)]">Defense</span>
			if score == 0 {
				<span class="text-xs font-semibold text-stone-400">N/A</span>
			} else {
				<span class="text-sm font-bold text-[var(--ps-ink)] font-data">{ strconv.Itoa(score) }/10</span>
			}
		</div>
		<div class="h-2 rounded-full overflow-hidden bg-orange-100">
			if score == 0 {
				<div class="h-full w-0 rounded-full bg-orange-400"></div>
			} else {
				<div class="h-full rounded-full bg-orange-400 origin-left" data-reveal style={ fmt.Sprintf("width: %d%%; transform: scaleX(0)", score*10) }></div>
			}
		</div>
	</div>
}

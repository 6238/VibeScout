package templates

import "strconv"

templ ScoutPage(event, match, scouterName string, singleTeam bool, teams []ScoutTeam) {
	@Layout("Vibe Scout | Match " + match) {
		<style>
			.page-transition { animation: slideIn 0.3s ease-out; }
			@keyframes slideIn { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
			.section-card { background: rgba(255,251,245,0.95); border: 2px solid #D2B48C; border-radius: 1.5rem; }
			.field-tag.active { background-color: #5D4037; color: #fff; border-color: #5D4037; }
			#voice-bar.is-listening { box-shadow: 0 0 0 3px rgba(93,64,55,0.2); }
			#voice-bar:not(.is-listening) #voice-dot { background: #D2B48C; }
			#voice-bar.is-listening #voice-dot { animation: voicePulse 1.2s ease-in-out infinite; }
			@keyframes voicePulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.85); } }
			[data-team-card] { border: 3px solid transparent; border-radius: 1.25rem; transition: border-color 0.15s, box-shadow 0.15s; }
			[data-team-card][data-alliance="Red"].is-talking-about { border-color: #b91c1c; box-shadow: 0 0 0 6px rgba(185,28,28,0.28); }
			[data-team-card][data-alliance="Blue"].is-talking-about { border-color: #1d4ed8; box-shadow: 0 0 0 6px rgba(29,78,216,0.28); }
		</style>

		<main class="p-3 pb-36 page-transition">
			<!-- Header -->
			<div class="max-w-4xl mx-auto mb-4 flex justify-between items-center bg-[#F2E8D5] p-4 rounded-2xl border-2 border-[#D2B48C] shadow-lg">
				<div>
					<p class="text-xs font-bold text-[#A1887F] uppercase">Match { match } • { scouterName }</p>
					<h1 class="text-lg font-black text-[#5D4037] uppercase truncate">{ event }</h1>
				</div>
				<div class={ "px-4 py-1 rounded-xl font-black text-sm border-2",
					templ.KV("bg-red-100 border-red-400 text-red-700", teams[0].Alliance == "Red"),
					templ.KV("bg-blue-100 border-blue-400 text-blue-700", teams[0].Alliance == "Blue") }>
					if singleTeam {
						{ teams[0].Alliance }
					} else {
						{ teams[0].Alliance + " Alliance" }
					}
				</div>
			</div>

			<!-- Voice notes -->
			<div id="voice-bar" class="max-w-4xl mx-auto mb-4 section-card p-4">
				<div class="flex flex-wrap items-center gap-3">
					<button id="voice-toggle" type="button" aria-pressed="false"
						class="bg-[#5D4037] text-white font-black py-3 px-5 rounded-2xl shadow-lg uppercase tracking-wide text-sm active:scale-95 transition">
						Start listening
					</button>
					<div class="flex-1 min-w-[12rem]">
						<p id="voice-status" class="text-sm font-bold text-[#5D4037]">Mic off — tap to dictate notes.</p>
						if !singleTeam {
							<p id="voice-talking" class="invisible mt-1 text-xs font-bold uppercase tracking-wide text-[#A1887F]">
								Talking about
								<span id="voice-talking-team" class="text-base font-black tracking-normal">—</span>
							</p>
						}
					</div>
					<div class="flex items-center gap-2 text-[#A1887F]">
						<span id="voice-dot" class="inline-block w-3 h-3 rounded-full bg-red-500"></span>
						<span class="text-xs font-black uppercase tracking-widest">Live</span>
					</div>
				</div>
				<p id="voice-caption" class="mt-3 min-h-[3rem] p-3 text-sm bg-[#FFFBF5] border-2 border-[#E0CDA8] rounded-xl text-[#5D4037]">
					if singleTeam {
						Talk, or type in the notes box.
					} else {
						Tap a notes box, then talk. Saying “team 1234” also switches.
					}
				</p>
			</div>

			<!-- Notes Section -->
			<div class="max-w-4xl mx-auto mb-5 section-card p-4">
				<h2 class="text-lg font-black text-[#5D4037] uppercase mb-4 text-center">Notes</h2>
				<div class={ "grid", templ.KV("grid-cols-1 sm:grid-cols-3 gap-4", !singleTeam), templ.KV("gap-6 max-w-3xl mx-auto", singleTeam) }>
					for _, team := range teams {
						<div data-team-card={ team.Number } data-alliance={ team.Alliance }
							class={ "p-2", templ.KV("cursor-pointer", !singleTeam) }>
							<label class={ "block text-sm font-black mb-2 text-center",
								templ.KV("text-red-700", team.Alliance == "Red"),
								templ.KV("text-blue-700", team.Alliance == "Blue") }>
								Team { team.Number }
								<span class="ml-1 text-xs font-bold text-[#8D6E63]">({ strconv.Itoa(team.DataCount) } pts)</span>
							</label>
							<div class="flex flex-wrap gap-1.5 mb-2">
								@fieldTagButton("Broke")
								@fieldTagButton("Played Defense")
								@fieldTagButton("Was Defended")
							</div>
							<div data-team-cats class="mb-2 space-y-1 text-xs"></div>
							if singleTeam {
								<textarea
									name={ "notes_" + team.Number }
									rows="14"
									class={ "w-full p-3 text-sm bg-white border-2 rounded-xl resize-none focus:outline-none focus:border-[#8D6E63]",
										templ.KV("border-red-300", team.Alliance == "Red"),
										templ.KV("border-blue-300", team.Alliance == "Blue") }
									placeholder="Observations..."></textarea>
							} else {
								<textarea
									name={ "notes_" + team.Number }
									rows="12"
									class={ "w-full p-3 text-sm bg-white border-2 rounded-xl resize-none focus:outline-none focus:border-[#8D6E63]",
										templ.KV("border-red-300", team.Alliance == "Red"),
										templ.KV("border-blue-300", team.Alliance == "Blue") }
									placeholder="Observations..."></textarea>
							}
							if !singleTeam {
								<p class="mt-1 text-xs text-center text-[#A1887F]">Tap this box to talk about this team</p>
							}
						</div>
					}
				</div>
				<p class="mt-3 text-xs text-center text-[#A1887F]">Notes are saved when you press Next Match</p>
			</div>

			<!-- Submit -->
			<div class="fixed bottom-0 left-0 right-0 p-4 bg-[#F2E8D5]/95 backdrop-blur-md flex justify-center z-50">
				<button id="next-match-btn" onclick="nextMatch()" class="bg-[#5D4037] text-white font-black py-3 px-12 rounded-2xl shadow-xl uppercase tracking-widest text-lg active:scale-95 transition">
					Next Match →
				</button>
			</div>

			<!-- Post-match review -->
			<div id="review-overlay" class="hidden fixed inset-0 z-[60] bg-[#4E342E]/70 overflow-y-auto">
				<div class="max-w-5xl mx-auto my-6 p-4">
					<div class="section-card p-5">
						<h2 class="text-xl font-black text-[#5D4037] uppercase text-center">Review notes</h2>
						<p class="text-sm text-[#8D6E63] text-center mb-4">Check that this matches what you said, then save.</p>
						<p class="text-xs font-black uppercase tracking-wide text-[#A1887F] mb-1">Transcript</p>
						<pre id="review-transcript" class="whitespace-pre-wrap text-sm bg-[#FFFBF5] border-2 border-[#E0CDA8] rounded-xl p-3 mb-4 max-h-40 overflow-y-auto text-[#5D4037]"></pre>
						<p id="review-error" class="text-sm text-red-700 mb-3"></p>
						<div id="review-teams"></div>
						<div class="mt-5 flex flex-wrap justify-center gap-3">
							<button id="review-back" type="button" class="px-6 py-3 rounded-2xl border-2 border-[#D2B48C] font-black uppercase text-[#5D4037] bg-white">Keep editing</button>
							<button id="review-confirm" type="button" class="px-8 py-3 rounded-2xl bg-[#5D4037] text-white font-black uppercase tracking-widest shadow-xl">Save &amp; next match</button>
						</div>
					</div>
				</div>
			</div>
		</main>

		@templ.JSONScript("scout-config", ScoutPageConfig{Teams: teams, OneRobot: singleTeam})
		<script>
			// Quick-tag buttons just toggle selected state; they stay out of the visible
			// notes textarea and get merged into the notes sent to the server on submit
			// (see nextMatch), so Gemini sees them without cluttering the scout's view.
			document.addEventListener('click', function(e) {
				const btn = e.target.closest('[data-tag-btn]');
				if (!btn) return;
				btn.classList.toggle('active');
			});

			async function nextMatch() {
				if (window.voiceScout && window.voiceScout.used()) {
					await window.voiceScout.openReview();
					return;
				}
				await saveAndAdvance();
			}

			async function saveAndAdvance() {
				if (window.voiceScout) window.voiceScout.stopListening();
				const params = new URLSearchParams(window.location.search);
				const eventKey = params.get('event_key') || '';
				const matchNum = parseInt(params.get('match_num') || '1');
				const scouter = params.get('scouter') || '';
				const pickedTeam = params.get('team');

				const teamCards = document.querySelectorAll('[data-team-card]');
				const teams = Array.from(teamCards).map(card => {
					const tags = Array.from(card.querySelectorAll('[data-tag-btn].active')).map(b => b.dataset.tag);
					const notes = card.querySelector('textarea')?.value || '';
					return {
						team_number: card.getAttribute('data-team-card'),
						notes: tags.length ? '[' + tags.join('] [') + '] ' + notes : notes
					};
				});

				const submission = {
					event_key: eventKey,
					match_num: matchNum,
					scouter_name: scouter,
					teams: teams
				};

				// Save on this device first — that can't fail — then let it sync in
				// the background instead of making the scout wait on (or lose data
				// to) a bad connection. The queue keeps retrying until the server
				// confirms it, including after this page has moved on.
				window.offlineSync.queue('scout', '/api/save-scout', submission);

				// Both modes pick a team/alliance each match, so always return to
				// Field Scouting to pick again for the next one.
				const next = new URLSearchParams({ event_key: eventKey, match_num: matchNum + 1, scouter: scouter });
				next.set('mode', pickedTeam ? 'one' : 'three');
				window.location.href = '/field-scout?' + next;
			}
			window.saveAndAdvance = saveAndAdvance;
		</script>
		<script src="/static/voice-scout.js"></script>
	}
}

// fieldTagButton is a toggleable pill button; selected tags are merged into
// the notes sent to the server on submit (see nextMatch in ScoutPage), kept
// out of the visible textarea.
templ fieldTagButton(tag string) {
	<button type="button" data-tag-btn data-tag={ tag }
		class="field-tag text-sm font-bold px-3.5 py-2 rounded-full border border-[#D2B48C] bg-white text-[#8D6E63] hover:bg-[#F2E8D5] transition">
		{ tag }
	</button>
}

package templates

import "strconv"

templ ScoutPage(event, match, scouterName string, oneRobot bool, teams []ScoutTeam) {
	@Layout("Vibe Scout | Match " + match) {
		<style>
			.page-transition { animation: slideIn 0.3s ease-out; }
			@keyframes slideIn { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
			.section-card { background: rgba(255,251,245,0.95); border: 2px solid #D2B48C; border-radius: 1.5rem; }
		</style>

		<main class="p-3 pb-36 page-transition">
			<!-- Header -->
			<div class="max-w-4xl mx-auto mb-4 flex justify-between items-center bg-[#F2E8D5] p-4 rounded-2xl border-2 border-[#D2B48C] shadow-lg">
				<div>
					<p class="text-xs font-bold text-[#A1887F] uppercase">Match { match } • { scouterName }</p>
					<h1 class="text-lg font-black text-[#5D4037] uppercase truncate">{ event }</h1>
				</div>
				if oneRobot {
					<div class={ "px-4 py-1 rounded-xl font-black text-sm border-2",
						templ.KV("bg-red-100 border-red-400 text-red-700", teams[0].Alliance == "Red"),
						templ.KV("bg-blue-100 border-blue-400 text-blue-700", teams[0].Alliance == "Blue") }>
						{ teams[0].Alliance }
					</div>
				} else {
					<div class="px-4 py-1 rounded-xl font-black text-sm border-2 bg-[#FFFBF5] border-[#D2B48C] text-[#5D4037]">
						All 6
					</div>
				}
			</div>

			<!-- Notes Section -->
			<div class="max-w-4xl mx-auto mb-5 section-card p-4">
				<h2 class="text-lg font-black text-[#5D4037] uppercase mb-4 text-center">Notes</h2>
				<div class={ "grid", templ.KV("grid-cols-3 gap-4", !oneRobot), templ.KV("gap-6 max-w-3xl mx-auto", oneRobot) }>
					for _, team := range teams {
						<div data-team-card={ team.Number }>
							<label class={ "block text-sm font-black mb-2 text-center",
								templ.KV("text-red-700", team.Alliance == "Red"),
								templ.KV("text-blue-700", team.Alliance == "Blue") }>
								Team { team.Number }
								<span class="ml-1 text-xs font-bold text-[#8D6E63]">({ strconv.Itoa(team.DataCount) } pts)</span>
							</label>
							if oneRobot {
								<!-- Checklist sits beside the notes on desktop and below them on mobile -->
								<div class="flex flex-col md:flex-row gap-3">
									<div class="flex-1 min-w-0">
										<textarea
											name={ "notes_" + team.Number }
											rows="14"
											class={ "w-full h-full p-3 text-sm bg-white border-2 rounded-xl resize-none focus:outline-none focus:border-[#8D6E63]",
												templ.KV("border-red-300", team.Alliance == "Red"),
												templ.KV("border-blue-300", team.Alliance == "Blue") }
											placeholder="Observations..."></textarea>
									</div>
									<div data-checklist class="md:w-60 shrink-0 space-y-2 bg-[#F2E8D5] border-2 border-[#D2B48C] rounded-xl p-3">
										@checklistSwitch(team.Number, "broke", "Broke")
										@checklistSwitch(team.Number, "played_defense", "Played defense")
										@checklistSwitch(team.Number, "was_defended", "Was defended")
										<div>
											<label for={ "auto_type_" + team.Number } class="block text-xs font-bold uppercase text-[#A1887F] mb-1">Auto type</label>
											<input id={ "auto_type_" + team.Number } type="text" data-field="auto_type" maxlength="80"
												placeholder="e.g. 2 piece center"
												class="w-full p-2 text-sm bg-white border-2 border-[#D2B48C] rounded-lg focus:outline-none focus:border-[#8D6E63]"/>
										</div>
									</div>
								</div>
							} else {
								<textarea
									name={ "notes_" + team.Number }
									rows="12"
									class={ "w-full p-3 text-sm bg-white border-2 rounded-xl resize-none focus:outline-none focus:border-[#8D6E63]",
										templ.KV("border-red-300", team.Alliance == "Red"),
										templ.KV("border-blue-300", team.Alliance == "Blue") }
									placeholder="Observations..."></textarea>
							}
							<p class="mt-1 text-xs text-center text-[#A1887F]">Notes are saved when you press Next Match</p>
						</div>
					}
				</div>
			</div>

			<!-- Submit -->
			<div class="fixed bottom-0 left-0 right-0 p-4 bg-[#F2E8D5]/95 backdrop-blur-md flex justify-center z-50">
				<button onclick="nextMatch()" class="bg-[#5D4037] text-white font-black py-3 px-12 rounded-2xl shadow-xl uppercase tracking-widest text-lg active:scale-95 transition">
					Next Match →
				</button>
			</div>
		</main>

		<script>
			async function nextMatch() {
				const params = new URLSearchParams(window.location.search);
				const eventKey = params.get('event_key') || '';
				const matchNum = parseInt(params.get('match_num') || '1');
				const scouter = params.get('scouter') || '';
				const pickedTeam = params.get('team');

				const teamCards = document.querySelectorAll('[data-team-card]');
				const teams = Array.from(teamCards).map(card => {
					const team = {
						team_number: card.getAttribute('data-team-card'),
						notes: card.querySelector('textarea')?.value || ''
					};
					// The checklist only exists in one-robot mode
					if (card.querySelector('[data-checklist]')) {
						team.has_checklist = true;
						team.broke = card.querySelector('[data-field=broke]').checked;
						team.played_defense = card.querySelector('[data-field=played_defense]').checked;
						team.was_defended = card.querySelector('[data-field=was_defended]').checked;
						team.auto_type = card.querySelector('[data-field=auto_type]').value;
					}
					return team;
				});

				const submission = {
					event_key: eventKey,
					match_num: matchNum,
					scouter_name: scouter,
					teams: teams
				};

				try {
					const resp = await fetch('/api/save-scout', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(submission)
					});

					if (resp.ok) {
						const next = new URLSearchParams({ event_key: eventKey, match_num: matchNum + 1, scouter: scouter });
						if (pickedTeam) {
							// One-robot mode: back to Field Scouting to pick a team for the next match
							next.set('mode', 'one');
							window.location.href = '/field-scout?' + next;
						} else {
							next.set('mode', 'all');
							window.location.href = '/scout?' + next;
						}
					} else {
						alert('Failed to save scout data.');
					}
				} catch (err) {
					alert('Error: ' + err.message);
				}
			}
		</script>
	}
}

// checklistSwitch is a yes/no toggle for one checklist question.
templ checklistSwitch(team string, field string, label string) {
	<label class="flex items-center justify-between gap-2 cursor-pointer select-none">
		<span class="text-sm font-bold text-[#5D4037]">{ label }</span>
		<span class="relative inline-flex items-center">
			<input type="checkbox" data-field={ field } id={ field + "_" + team } class="sr-only peer"/>
			<span class="w-12 h-7 rounded-full bg-stone-300 transition peer-checked:bg-[#5D4037] peer-focus-visible:ring-2 peer-focus-visible:ring-[#8D6E63]"></span>
			<span class="absolute left-1 top-1 w-5 h-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
			<span class="absolute -left-9 text-xs font-bold text-[#A1887F] peer-checked:hidden">No</span>
			<span class="absolute -left-9 text-xs font-bold text-[#5D4037] hidden peer-checked:inline">Yes</span>
		</span>
	</label>
}

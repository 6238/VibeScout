package templates

import "strconv"

templ ScoutPage(event, match, scouterName string, singleTeam bool, teams []ScoutTeam) {
	@Layout("Vibe Scout | Match " + match) {
		<style>
			.page-transition { animation: slideIn 0.3s ease-out; }
			@keyframes slideIn { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
			.section-card { background: rgba(254,252,245,0.95); border: 1px solid var(--ps-border); border-radius: var(--ps-radius-lg); }
			.field-tag.active { background-color: var(--ps-red-strong); color: #fff; border-color: var(--ps-red-strong); }
			#voice-bar.is-listening { box-shadow: 0 0 0 3px rgba(126,55,58,0.2); }
			#voice-bar:not(.is-listening) #voice-dot { background: var(--ps-border); }
			#voice-bar.is-listening #voice-dot { animation: voicePulse 1.2s ease-in-out infinite; }
			@keyframes voicePulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.85); } }
			[data-team-card] { border: 3px solid transparent; border-radius: var(--ps-radius-lg); transition: border-color 0.15s, box-shadow 0.15s; }
			[data-team-card][data-alliance="Red"].is-talking-about { border-color: #b91c1c; box-shadow: 0 0 0 6px rgba(185,28,28,0.28); }
			[data-team-card][data-alliance="Blue"].is-talking-about { border-color: #1d4ed8; box-shadow: 0 0 0 6px rgba(29,78,216,0.28); }
		</style>

		<main class="p-3 pb-36 page-transition">
			<!-- Header -->
			<div class="max-w-4xl mx-auto mb-4 flex justify-between items-center ps-card p-4">
				<div>
					<h1 class="text-lg font-extrabold text-[var(--ps-ink)] truncate">{ event }</h1>
					<p class="text-sm font-medium text-[var(--ps-muted)]">{ "Match " + match + ", scouted by " + scouterName }</p>
				</div>
				<div class={ "px-3 py-1 rounded-full font-bold text-sm border",
					templ.KV("bg-[var(--ps-red-light)] border-[var(--ps-red)] text-[var(--ps-red-strong)]", teams[0].Alliance == "Red"),
					templ.KV("bg-[var(--ps-blue-light)] border-[var(--ps-blue)] text-[var(--ps-blue-strong)]", teams[0].Alliance == "Blue") }>
					if singleTeam {
						{ teams[0].Alliance }
					} else {
						{ teams[0].Alliance + " alliance" }
					}
				</div>
			</div>

			<!-- Voice notes -->
			<div id="voice-bar" class="max-w-4xl mx-auto mb-4 section-card p-4">
				<div class="flex flex-wrap items-center gap-3">
					<button id="voice-toggle" type="button" aria-pressed="false" class="btn btn-primary">
						@iconMic("w-4 h-4")
						<span id="voice-toggle-label">Start listening</span>
					</button>
					<div class="flex-1 min-w-[12rem]">
						<p id="voice-status" class="text-sm font-semibold text-[var(--ps-ink)]">Mic off — tap to dictate notes.</p>
						if !singleTeam {
							<p id="voice-talking" class="invisible mt-1 text-xs font-semibold text-[var(--ps-muted)]">
								Talking about
								<span id="voice-talking-team" class="text-base font-bold text-[var(--ps-ink)]">—</span>
							</p>
						}
					</div>
					<div class="flex items-center gap-2 text-[var(--ps-muted)]">
						<span id="voice-dot" class="inline-block w-2.5 h-2.5 rounded-full bg-red-500"></span>
						<span class="text-xs font-bold">Live</span>
					</div>
				</div>
				<p id="voice-caption" class="mt-3 min-h-[3rem] p-3 text-sm bg-[var(--ps-input)] border border-[var(--ps-border-soft)] rounded-[var(--ps-radius-md)] text-[var(--ps-ink)]">
					if singleTeam {
						Talk, or type in the notes box.
					} else {
						Tap a notes box, then talk. Saying “team 1234” also switches.
					}
				</p>
			</div>

			<!-- Notes Section -->
			<div class="max-w-4xl mx-auto mb-5 section-card p-4">
				<h2 class="text-base font-extrabold text-[var(--ps-ink)] mb-4 text-center">Notes</h2>
				<div class={ "grid", templ.KV("grid-cols-1 sm:grid-cols-3 gap-4", !singleTeam), templ.KV("gap-6 max-w-3xl mx-auto", singleTeam) }>
					for _, team := range teams {
						<div data-team-card={ team.Number } data-alliance={ team.Alliance }
							class={ "p-2", templ.KV("cursor-pointer", !singleTeam) }>
							<label class={ "block text-sm font-bold mb-2 text-center",
								templ.KV("text-[var(--ps-red-strong)]", team.Alliance == "Red"),
								templ.KV("text-[var(--ps-blue-strong)]", team.Alliance == "Blue") }>
								Team { team.Number }
								<span class="ml-1 text-xs font-semibold text-[var(--ps-ink-soft)]">({ strconv.Itoa(team.DataCount) } pts)</span>
							</label>
							<div class="flex flex-wrap gap-1.5 mb-2">
								@fieldTagButton("Broke")
								@fieldTagButton("Played Defense")
								@fieldTagButton("Was Defended")
							</div>
							<div data-team-cats class="mb-2 space-y-1 text-xs"></div>
							if singleTeam {
								<textarea
									name={ "notes_" + team.Number }
									rows="14"
									class={ "w-full p-3 text-sm bg-white border-2 rounded-[var(--ps-radius-md)] resize-none focus:outline-none focus:border-[var(--ps-gold-strong)]",
										templ.KV("border-[var(--ps-red)]", team.Alliance == "Red"),
										templ.KV("border-[var(--ps-blue)]", team.Alliance == "Blue") }
									placeholder="Observations..."></textarea>
							} else {
								<textarea
									name={ "notes_" + team.Number }
									rows="12"
									class={ "w-full p-3 text-sm bg-white border-2 rounded-[var(--ps-radius-md)] resize-none focus:outline-none focus:border-[var(--ps-gold-strong)]",
										templ.KV("border-[var(--ps-red)]", team.Alliance == "Red"),
										templ.KV("border-[var(--ps-blue)]", team.Alliance == "Blue") }
									placeholder="Observations..."></textarea>
							}
							if !singleTeam {
								<p class="mt-1 text-xs text-center text-[var(--ps-muted)]">Tap this box to talk about this team</p>
							}
						</div>
					}
				</div>
				<p class="mt-3 text-xs text-center text-[var(--ps-muted)]">Notes are saved when you press Next Match</p>
			</div>

			<!-- Submit -->
			<div class="fixed bottom-0 left-0 right-0 p-4 bg-[var(--ps-surface)]/95 backdrop-blur-md flex justify-center z-50">
				<button id="next-match-btn" onclick="nextMatch()" class="btn btn-primary btn-lg px-12">
					@iconFlag("w-5 h-5")
					<span id="next-match-label">Next match</span>
				</button>
			</div>

			<!-- Post-match review -->
			<div id="review-overlay" class="hidden fixed inset-0 z-[60] bg-[var(--ps-ink)]/70 overflow-y-auto">
				<div class="max-w-5xl mx-auto my-6 p-4">
					<div class="section-card p-5">
						<h2 class="text-lg font-extrabold text-[var(--ps-ink)] text-center">Review notes</h2>
						<p class="text-sm text-[var(--ps-ink-soft)] text-center mb-4">Check that this matches what you said, then save.</p>
						<p class="text-xs font-bold text-[var(--ps-muted)] mb-1">Transcript</p>
						<pre id="review-transcript" class="whitespace-pre-wrap text-sm bg-[var(--ps-input)] border border-[var(--ps-border-soft)] rounded-[var(--ps-radius-md)] p-3 mb-4 max-h-40 overflow-y-auto text-[var(--ps-ink)]"></pre>
						<p id="review-error" class="text-sm text-red-700 mb-3"></p>
						<div id="review-teams"></div>
						<div class="mt-5 flex flex-wrap justify-center gap-3">
							<button id="review-back" type="button" class="btn btn-secondary">Keep editing</button>
							<button id="review-confirm" type="button" class="btn btn-primary">Save and continue</button>
						</div>
					</div>
				</div>
			</div>
		</main>

		@templ.JSONScript("scout-config", ScoutPageConfig{Teams: teams, OneRobot: singleTeam})
		<script>
			// Quick-tag buttons just toggle selected state; saveAndAdvance reads
			// which ones are active straight off the DOM and sends them as
			// structured fields (broke/played_defense/was_defended), not merged
			// into the notes text — see formatChecklistNote on the server for how
			// they're turned back into a sentence Gemini reads.
			document.addEventListener('click', function(e) {
				const btn = e.target.closest('[data-tag-btn]');
				if (!btn) return;
				btn.classList.toggle('active');
			});

			async function nextMatch() {
				if (window.voiceScout && window.voiceScout.used()) {
					await window.voiceScout.openReview();
					return;
				}
				await saveAndAdvance();
			}

			async function saveAndAdvance() {
				if (window.voiceScout) window.voiceScout.stopListening();
				const params = new URLSearchParams(window.location.search);
				const eventKey = params.get('event_key') || '';
				const matchNum = parseInt(params.get('match_num') || '1');
				const scouter = params.get('scouter') || '';
				const pickedTeam = params.get('team');

				// A one-robot scout is watching just this robot, not splitting
				// attention across a whole alliance — sent along so notes from the
				// two modes can be told apart later (see combineTeamNotes on the
				// server, and the ScoutPageConfig JSON this page already embeds).
				const scoutConfig = JSON.parse(document.getElementById('scout-config')?.textContent || '{}');
				const singleTeam = !!scoutConfig.one_robot;

				const teamCards = document.querySelectorAll('[data-team-card]');
				const teams = Array.from(teamCards).map(card => {
					const isActive = tag => !!card.querySelector('[data-tag-btn][data-tag="' + tag + '"].active');
					const notes = card.querySelector('textarea')?.value || '';
					return {
						team_number: card.getAttribute('data-team-card'),
						notes: notes,
						has_checklist: true,
						broke: isActive('Broke'),
						played_defense: isActive('Played Defense'),
						was_defended: isActive('Was Defended'),
						single_team: singleTeam
					};
				});

				const submission = {
					event_key: eventKey,
					match_num: matchNum,
					scouter_name: scouter,
					teams: teams
				};

				// Save on this device first — that can't fail — then let it sync in
				// the background instead of making the scout wait on (or lose data
				// to) a bad connection. The queue keeps retrying until the server
				// confirms it, including after this page has moved on.
				window.offlineSync.queue('scout', '/api/save-scout', submission);

				// Both modes pick a team/alliance each match, so always return to
				// Field Scouting to pick again for the next one.
				const next = new URLSearchParams({ event_key: eventKey, match_num: matchNum + 1, scouter: scouter });
				next.set('mode', pickedTeam ? 'one' : 'three');
				window.location.href = '/field-scout?' + next;
			}
			window.saveAndAdvance = saveAndAdvance;
		</script>
		<script src="/static/voice-scout.js"></script>
	}
}

// fieldTagButton is a toggleable pill button; its state is read straight off
// the DOM on submit and sent as a structured field (see saveAndAdvance in
// ScoutPage), kept out of the visible notes textarea.
templ fieldTagButton(tag string) {
	<button type="button" data-tag-btn data-tag={ tag }
		class="field-tag text-sm font-semibold px-3.5 py-2 rounded-full border border-[var(--ps-border)] bg-white text-[var(--ps-ink-soft)] hover:bg-[var(--ps-surface)] transition">
		{ tag }
	</button>
}

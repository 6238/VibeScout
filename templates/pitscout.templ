package templates

import "fmt"

var pitScoutQuestions = []string{
	"Robot archetype: scorer, defender, feeder/support, or all-around?",
	"Preferred alliance role: offense, defense, or feeding?",
	"What alliance partner archetype complements them best?",
	"Backup plan if their main strategy gets countered or defended?",
	"Driver safety: would they run you over?",
	"Biggest robot problem this season?",
	"2 matches back to back (battery swap only)? 3?",
	"In-match problems & how you fixed them?",
	"How would you do without mentors here?",
	"Fab & assembly: hard or easy?",
	"If limited to one game task, which?",
	"Team's biggest strength?",
	"Robot part you're most proud of?",
	"How much of the design is in CAD?",
	"Pre-game checklist?",
	"Debugging checklist when broken?",
	"Team organization (mentors, captains, leads)?",
	"Ask about the robot: why this choice? anything odd?",
}

templ PitScoutPage(eventKey string, eventName string) {
	@Layout("Vibe Scout | Pit Scouting") {
		<style>
			#pit-teams.hide-scouted [data-scouted] { display: none; }
			#pit-teams .pit-highlight {
				background-color: rgba(250, 204, 21, 0.55) !important;
				border-color: #CA8A04 !important;
				outline: 3px solid #FACC15;
				z-index: 5;
			}
		</style>
		<main class="flex flex-col items-center justify-center min-h-screen px-3 py-6">
			<div class="ps-card w-full max-w-md md:max-w-4xl p-4 md:p-6">
				<h1 class="text-xl font-extrabold text-[var(--ps-ink)] mb-1 text-center tracking-tight">Pit scouting</h1>
				<p class="text-sm font-medium text-[var(--ps-muted)] mb-3 text-center">{ eventName }</p>
				<input type="hidden" id="pit-event" name="event_key" value={ eventKey }/>

				<!-- Form first, then the team map(s) full-width below it -->
				<div>
					<form id="pit-form" class="space-y-3">
						<div>
							<label for="pit-team-number" class="ps-label">Team number</label>
							<div class="relative">
								<input id="pit-team-number" type="text" name="team_number" inputmode="numeric" pattern="[0-9]+" placeholder="Search a team number" required
									autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="pit-team-suggest" aria-expanded="false"
									class="ps-field font-data font-semibold"/>
								<ul id="pit-team-suggest" role="listbox"
									class="hidden absolute z-10 left-0 right-0 mt-1 max-h-64 overflow-y-auto bg-[var(--ps-input)] border border-[var(--ps-border)] rounded-lg shadow-lg"></ul>
							</div>
							<div id="pit-team-error" class="hidden mt-2 ml-1 text-sm font-semibold text-red-700"></div>
							<div id="pit-edit-status" class="hidden mt-2 ml-1 text-sm font-semibold text-[var(--ps-ink-soft)]"></div>
						</div>

						<div>
							<label for="pit-summary" class="ps-label">Ask about</label>
							<ol class="list-decimal list-inside text-base leading-snug text-[var(--ps-ink)] bg-[var(--ps-input)] border border-[var(--ps-border-soft)] rounded-[var(--ps-radius-md)] px-3 py-2 mb-2 space-y-1">
								for _, q := range pitScoutQuestions {
									<li>{ q }</li>
								}
							</ol>
							<textarea id="pit-summary" name="summary" rows="8" required placeholder="Summary of their answers..."
								class="ps-field"></textarea>
						</div>

						<!-- Strategy-team clarifications on this team's pit notes (see
						     note_clarifications), shown right under the notes they're
						     about — the same place those notes themselves get edited —
						     with a delete button on each. -->
						<div id="pit-clarifications" class="hidden space-y-1.5"></div>

						<button id="pit-submit" type="submit" class="btn btn-primary btn-block btn-lg">
							Save pit scouting
						</button>
					</form>
					<div id="pit-result" class="mt-3 text-center font-semibold text-sm text-[var(--ps-ink)]"></div>
				</div>

				<div class="mt-5">
					<div class="flex justify-between items-center mb-1">
						<span class="ps-label mb-0">Teams</span>
						<label class="flex items-center gap-2 text-sm font-semibold text-[var(--ps-ink-soft)] cursor-pointer select-none">
							<input id="pit-hide-scouted" type="checkbox" class="w-5 h-5 accent-[var(--ps-red-strong)]"/>
							Hide scouted
						</label>
					</div>
					<p class="text-xs text-[var(--ps-muted)] mb-2">Scroll or pinch to find a pit, then tap its number.</p>
					<div id="pit-teams"
						hx-get="/api/pit-teams"
						hx-include="#pit-event"
						hx-trigger="load, pitSaved from:body"
						hx-swap="innerHTML">
						<p class="text-sm text-[var(--ps-muted)]">Loading teams…</p>
					</div>
				</div>
			</div>

			<div class="mt-4 text-center">
				<a href={ templ.SafeURL("/?event_key=" + eventKey) } class="btn btn-ghost btn-sm">‹ Home</a>
			</div>
			<script>
				(function() {
					var teams = document.getElementById('pit-teams');
					var hide = document.getElementById('pit-hide-scouted');
					var form = document.getElementById('pit-form');
					var input = document.getElementById('pit-team-number');
					var suggest = document.getElementById('pit-team-suggest');
					var summary = document.getElementById('pit-summary');
					var status = document.getElementById('pit-edit-status');
					var submit = document.getElementById('pit-submit');
					var result = document.getElementById('pit-result');
					var clarifications = document.getElementById('pit-clarifications');

					var currentTeam = null;   // team whose notes state is loaded
					var loadedSummary = null; // existing notes put in the text box, if any
					var loadSeq = 0;
					var highlighted = -1;

					// ── Existing notes ──
					function setStatus(html) {
						status.innerHTML = html;
						status.classList.toggle('hidden', html === '');
					}
					function setEditing(team, text, clar) {
						summary.value = text;
						loadedSummary = text;
						setStatus('Editing existing notes for team ' + team);
						submit.textContent = 'Update pit scouting';
						renderClarifications(team, clar);
					}
					function setNew() {
						loadedSummary = null;
						setStatus('');
						submit.textContent = 'Save pit scouting';
						renderClarifications(null, []);
					}

					// Shows every clarification the strategy team has added on top of
					// this team's pit notes, each with its own delete button — anyone
					// can add one with no login, so anyone can also take one back, e.g.
					// once the note above has been edited to resolve what it disagreed
					// with. Deleting confirms first and is permanent.
					function renderClarifications(team, list) {
						list = list || [];
						clarifications.innerHTML = '';
						if (list.length === 0) { clarifications.classList.add('hidden'); return; }
						clarifications.classList.remove('hidden');
						var heading = document.createElement('p');
						heading.className = 'text-xs font-semibold text-[var(--ps-muted)] mb-1';
						heading.textContent = 'Clarifications';
						clarifications.appendChild(heading);
						list.forEach(function(c) {
							var row = document.createElement('div');
							row.className = 'flex items-start justify-between gap-2 ps-chip-gold rounded-[var(--ps-radius-sm)] px-3 py-1.5';
							var p = document.createElement('p');
							p.className = 'text-sm text-[var(--ps-ink)] flex-1 font-normal';
							p.textContent = c.text + ' — ' + (c.author ? c.author + ', ' : '') + c.when;
							var del = document.createElement('button');
							del.type = 'button';
							del.title = 'Delete this clarification';
							del.className = 'shrink-0 text-xs font-bold text-[var(--ps-red-strong)] hover:text-[var(--ps-ink)] px-1';
							del.textContent = '✕';
							del.addEventListener('click', function() {
								if (!confirm("Delete this clarification? This can't be undone.")) return;
								fetch('/api/delete-clarification', {
									method: 'POST',
									headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
									body: new URLSearchParams({ id: c.id, team_number: team, note_type: 'pit' })
								}).then(function() {
									return fetch('/api/pit-note?team_number=' + encodeURIComponent(team));
								}).then(function(r) { return r.json(); })
								.then(function(note) { renderClarifications(team, note.clarifications); });
							});
							row.appendChild(p);
							row.appendChild(del);
							clarifications.appendChild(row);
						});
					}
					// True if the text box holds something the scout typed that isn't saved anywhere
					function hasUnsavedText() {
						return summary.value.trim() !== '' && summary.value !== (loadedSummary || '');
					}

					// ── Only teams on this event's list can be searched or scouted ──
					var teamError = document.getElementById('pit-team-error');
					function isEventTeam(n) {
						return eventTeams().some(function(t) { return t.number === n; });
					}
					// True once the list has loaded and nothing in it matches what was typed
					function noSuchTeam(q) {
						var all = eventTeams();
						return q !== '' && all.length > 0 && !all.some(function(t) { return t.number.indexOf(q) !== -1; });
					}
					function showTeamError(q) {
						teamError.textContent = q ? 'Team ' + q + " isn't on this event's team list." : '';
						teamError.classList.toggle('hidden', !q);
					}

					function loadTeam(team) {
						team = (team || '').trim();
						if (team !== '' && eventTeams().length && !isEventTeam(team)) team = '';
						if (team === currentTeam) return;
						currentTeam = team;
						var seq = ++loadSeq;
						if (team === '') {
							if (!hasUnsavedText()) summary.value = '';
							setNew();
							return;
						}
						fetch('/api/pit-note?team_number=' + encodeURIComponent(team))
							.then(function(r) { return r.json(); })
							.then(function(note) {
								if (seq !== loadSeq) return; // a newer team was picked
								if (!note.exists) {
									if (!hasUnsavedText()) summary.value = '';
									setNew();
									return;
								}
								if (!hasUnsavedText()) {
									setEditing(team, note.summary, note.clarifications);
									return;
								}
								// Don't clobber what they typed; let them choose
								setStatus('Team ' + team + ' already has notes. Saving will replace them. ' +
									'<button type="button" id="pit-load-existing" class="underline">Load existing notes</button>');
								submit.textContent = 'Update pit scouting';
								loadedSummary = null;
								document.getElementById('pit-load-existing').onclick = function() {
									setEditing(team, note.summary, note.clarifications);
									summary.focus();
								};
							});
					}

					// ── Type-ahead ──
					function eventTeams() {
						return Array.prototype.map.call(teams.querySelectorAll('[data-pit-team]'), function(b) {
							return { number: b.dataset.pitTeam, scouted: b.hasAttribute('data-scouted') };
						});
					}
					// ── Map highlight ──
					function clearHighlight() {
						Array.prototype.forEach.call(teams.querySelectorAll('.pit-highlight'), function(b) {
							b.classList.remove('pit-highlight');
						});
					}
					// Highlights the team on the map and centers it inside the map box only;
					// the page never scrolls, so the scout can keep typing.
					function highlightTeam(team) {
						clearHighlight();
						var btn = teams.querySelector('[data-pit-team="' + team + '"]');
						if (!btn || !btn.parentElement || btn.parentElement.tagName !== 'DIV' || !btn.style.left) return;
						btn.classList.add('pit-highlight');
						var box = teams.firstElementChild;
						if (box && box.scrollWidth > 0) {
							var b = btn.getBoundingClientRect(), c = box.getBoundingClientRect();
							box.scrollTo({
								left: box.scrollLeft + (b.left - c.left) - c.width / 2 + b.width / 2,
								top: box.scrollTop + (b.top - c.top) - c.height / 2 + b.height / 2,
								behavior: 'smooth'
							});
						}
					}
					function closeSuggest() {
						suggest.classList.add('hidden');
						input.setAttribute('aria-expanded', 'false');
						highlighted = -1;
					}
					function renderSuggest() {
						var q = input.value.trim();
						if (q === '') { closeSuggest(); return; }
						var all = eventTeams();
						var starts = all.filter(function(t) { return t.number.indexOf(q) === 0; });
						var contains = all.filter(function(t) { return t.number.indexOf(q) > 0; });
						var list = starts.concat(contains).slice(0, 8);
						if (list.length === 0 || (list.length === 1 && list[0].number === q)) { closeSuggest(); return; }
						highlighted = 0;
						suggest.innerHTML = '';
						list.forEach(function(t, i) {
							var li = document.createElement('li');
							li.setAttribute('role', 'option');
							li.dataset.team = t.number;
							li.className = 'suggest-item flex justify-between items-center px-3 py-2 cursor-pointer font-semibold text-[var(--ps-ink)]';
							li.innerHTML = '<span></span>' + (t.scouted ? '<span class="text-xs font-semibold text-[var(--ps-muted)]">scouted, tap to edit</span>' : '');
							li.firstChild.textContent = t.number;
							suggest.appendChild(li);
						});
						paintHighlight();
						suggest.classList.remove('hidden');
						input.setAttribute('aria-expanded', 'true');
					}
					function paintHighlight() {
						Array.prototype.forEach.call(suggest.children, function(li, i) {
							li.classList.toggle('bg-[var(--ps-panel)]', i === highlighted);
							li.setAttribute('aria-selected', i === highlighted ? 'true' : 'false');
						});
					}
					function pick(team) {
						input.value = team;
						closeSuggest();
						if (team !== '' && eventTeams().length && !isEventTeam(team)) {
							showTeamError(team);
							clearHighlight();
							loadTeam('');
							return;
						}
						showTeamError('');
						loadTeam(team);
						highlightTeam(team);
						summary.focus();
					}

					input.addEventListener('input', function() {
						input.value = input.value.replace(/[^0-9]/g, '');
						renderSuggest();
						var q = input.value.trim();
						showTeamError(noSuchTeam(q) ? q : '');
						// Highlight as soon as the typed number (or the top suggestion) is a real team
						var match = q && eventTeams().filter(function(t) { return t.number === q; })[0];
						if (!match && q) match = eventTeams().filter(function(t) { return t.number.indexOf(q) === 0; })[0];
						if (match) highlightTeam(match.number); else clearHighlight();
					});
					input.addEventListener('keydown', function(e) {
						var open = !suggest.classList.contains('hidden');
						if (e.key === 'ArrowDown' && open) {
							e.preventDefault();
							highlighted = Math.min(highlighted + 1, suggest.children.length - 1);
							paintHighlight();
						} else if (e.key === 'ArrowUp' && open) {
							e.preventDefault();
							highlighted = Math.max(highlighted - 1, 0);
							paintHighlight();
						} else if (e.key === 'Enter') {
							e.preventDefault(); // never submit from the team box
							if (open && highlighted >= 0) pick(suggest.children[highlighted].dataset.team);
							else pick(input.value);
							highlightTeam(input.value.trim());
						} else if (e.key === 'Escape') {
							closeSuggest();
						}
					});
					// mousedown so it fires before the input loses focus
					suggest.addEventListener('mousedown', function(e) {
						var li = e.target.closest('[data-team]');
						if (!li) return;
						e.preventDefault();
						pick(li.dataset.team);
						highlightTeam(li.dataset.team);
					});
					input.addEventListener('blur', function() {
						closeSuggest();
						loadTeam(input.value);
					});

					// ── Team list ──
					teams.addEventListener('click', function(e) {
						var btn = e.target.closest('[data-pit-team]');
						if (!btn) return;
						pick(btn.dataset.pitTeam);
					});
					// The class lives on the htmx container, so it survives list refreshes
					hide.addEventListener('change', function() {
						teams.classList.toggle('hide-scouted', hide.checked);
					});

					// ── Save on this device first, sync in the background ──
					// (see /static/offline-sync.js). A bad connection can no longer
					// lose a pit interview: it's saved before the network is even
					// touched, and resent automatically until the server confirms it.
					// Only teams on the event list can be scouted; reject others
					// before queuing anything.
					form.addEventListener('submit', function(e) {
						e.preventDefault();
						var teamNumber = input.value.trim();
						var summaryText = summary.value;
						if (!teamNumber || !summaryText.trim()) return; // required fields
						var list = eventTeams();
						if (list.length && !list.some(function(t) { return t.number === teamNumber; })) {
							showTeamError(teamNumber);
							return;
						}

						window.offlineSync.queue('pit', '/api/save-pit-scout',
							{ team_number: teamNumber, summary: summaryText }, 'form');

						form.reset();
						showTeamError('');
						currentTeam = null;
						setNew();
						result.textContent = 'Saved on this device — sending to the server…';
					});
					// The team list's "scouted" marks reflect real server state, so only
					// refresh it once a queued pit entry actually reaches the server.
					window.offlineSync.onSynced(function(item) {
						if (item.kind !== 'pit') return;
						document.body.dispatchEvent(new Event('pitSaved'));
					});
				})();
			</script>
		</main>
	}
}

templ PitTeamList(teams []PitTeam, errMsg string) {
	if errMsg != "" {
		<p class="text-sm text-red-700 ml-2">{ errMsg }</p>
	} else if len(teams) == 0 {
		<p class="text-sm text-[var(--ps-muted)]">No teams listed for this event yet.</p>
	} else {
		<div class="max-h-[32rem] overflow-auto ps-panel p-2 space-y-3">
			if len(mapTeamsFor(teams, "pit-map1.webp")) > 0 {
				@pitMapBlock("pit-map1.webp", mapTeamsFor(teams, "pit-map1.webp"))
			}
			if len(mapTeamsFor(teams, "pit-map2.webp")) > 0 {
				@pitMapBlock("pit-map2.webp", mapTeamsFor(teams, "pit-map2.webp"))
			}
			if len(unmappedPitTeams(teams)) > 0 {
				<div>
					<p class="text-xs font-semibold text-[var(--ps-muted)] mb-1">Not on the map</p>
					<div class="flex flex-wrap content-start gap-2">
						for _, t := range unmappedPitTeams(teams) {
							@pitTeamButton(t)
						}
					</div>
				</div>
			}
		</div>
		<p class="text-xs text-[var(--ps-muted)] mt-2">
			{ fmt.Sprintf("%d of %d scouted", countScouted(teams), len(teams)) } — tap a team to fill it in
		</p>
	}
}

templ pitMapBlock(image string, teams []pitMapTeam) {
	<div class="relative min-w-[700px] w-full rounded-[var(--ps-radius-md)] border border-[var(--ps-border)] overflow-hidden" style={ fmt.Sprintf("aspect-ratio: %.4f", 1/pitMapImageAspect[image]) }>
		<img src={ "/static/" + image } class="absolute inset-0 w-full h-full object-contain" alt="Pit map"/>
		for _, t := range teams {
			@pitMapHotspot(t)
		}
	</div>
}

templ pitMapHotspot(t pitMapTeam) {
	if t.Scouted {
		<button type="button" data-pit-team={ t.Number } data-scouted
			style={ hotspotStyle(t.Pos) }
			class="absolute rounded-sm bg-[var(--ps-red-strong)]/80 border border-[var(--ps-ink)] text-[var(--ps-white)] text-xs font-black flex items-center justify-center">
			✓
		</button>
	} else {
		<button type="button" data-pit-team={ t.Number }
			style={ hotspotStyle(t.Pos) }
			class="absolute rounded-sm bg-[var(--ps-border)]/50 border border-[var(--ps-border)] hover:bg-[var(--ps-gold)]/70 hover:border-[var(--ps-gold-strong)] active:bg-[var(--ps-gold)] transition"
			aria-label={ "Team " + t.Number }></button>
	}
}

templ pitTeamButton(t PitTeam) {
	if t.Scouted {
		<button type="button" data-pit-team={ t.Number } data-scouted
			class="px-4 py-3 rounded-[var(--ps-radius-sm)] text-base font-semibold line-through text-stone-400 bg-stone-100 border border-stone-200">
			{ t.Number }
		</button>
	} else {
		<button type="button" data-pit-team={ t.Number }
			class="px-4 py-3 rounded-[var(--ps-radius-sm)] text-base font-semibold text-[var(--ps-ink)] bg-[var(--ps-input)] border border-[var(--ps-border)] hover:border-[var(--ps-ink-soft)] transition">
			{ t.Number }
		</button>
	}
}

func countScouted(teams []PitTeam) int {
	n := 0
	for _, t := range teams {
		if t.Scouted {
			n++
		}
	}
	return n
}

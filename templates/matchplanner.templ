package templates

import "strconv"

templ MatchPlannerPage(data MatchPlannerPageData) {
	@Layout("Vibe Scout | Match Planner") {
		<style>
			.htmx-indicator { display: none; }
			.htmx-request .htmx-indicator { display: flex; }
			.htmx-request.htmx-indicator { display: flex; }
		</style>

		<main class="container mx-auto px-4 py-8">
			<div class="max-w-4xl mx-auto">
				<div class="ps-card p-6 mb-6">
					<h1 class="text-2xl font-extrabold text-[var(--ps-ink)] mb-1 tracking-tight">Match planner</h1>
					<p class="text-sm font-medium text-[var(--ps-muted)] mb-4">{ data.EventName }</p>

					<form class="flex gap-3 items-end flex-wrap"
						hx-post="/api/match-plan"
						hx-target="#plan-results"
						hx-swap="innerHTML"
						hx-indicator="#loading">
						<input type="hidden" name="event_key" value={ data.EventKey }/>
						<div class="w-28">
							<label class="ps-label">Team</label>
							<input type="text" name="team_number" placeholder="e.g. 254" required
								class="ps-field font-data font-semibold" />
						</div>
						<div class="w-24">
							<label class="ps-label">Match</label>
							<input type="number" name="match_num" placeholder="e.g. 5" min="1" required
								class="ps-field font-data font-semibold" />
						</div>
						<button type="submit" class="btn btn-primary">
							@iconTarget("w-4 h-4")
							Plan match
						</button>
					</form>
				</div>

				<!-- Loading indicator -->
				<div id="loading" class="htmx-indicator items-center justify-center gap-3 py-12 text-[var(--ps-muted)]">
					<svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
					</svg>
					<span class="font-semibold text-lg">Generating match plans…</span>
				</div>

				<div id="plan-results"></div>
			</div>

			<div class="mt-6 flex gap-2 justify-center flex-wrap">
				<a href={ templ.SafeURL("/next-match?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
					@iconFlag("w-4 h-4")
					Next match
				</a>
				<a href={ templ.SafeURL("/pick-list?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
					@iconBars("w-4 h-4")
					Pick list
				</a>
				<a href={ templ.SafeURL("/?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
					@iconHome("w-4 h-4")
					Home
				</a>
			</div>
		</main>
	}
}

templ MatchPlannerResults(cards []MatchPlanCard, ourTeam string) {
	if len(cards) == 0 {
		<div class="text-center py-12 text-[var(--ps-muted)]">
			<p class="text-xl font-bold">Team { ourTeam } not found in this event's schedule.</p>
			<p class="text-sm mt-2">Check the team number and event, or the schedule may not be available yet.</p>
		</div>
	} else {
		<div class="space-y-4">
			for _, card := range cards {
				<div class="ps-card p-5">
					<!-- Match header -->
					<div class="flex justify-between items-center mb-4">
						<h2 class="text-lg font-extrabold text-[var(--ps-ink)]">Match { strconv.Itoa(card.MatchNum) }</h2>
						<div class="flex items-center gap-2">
							if card.FromCache {
								<span class="ps-chip">Cached</span>
							} else {
								<span class="ps-chip ps-chip-gold">Fresh</span>
							}
						</div>
					</div>

					<!-- Alliance breakdown -->
					<div class="grid grid-cols-2 gap-3 mb-4">
						<div class="rounded-[var(--ps-radius-md)] p-3 border-2 bg-red-50 border-red-300">
							<p class="text-xs font-bold text-red-600 mb-2">Red alliance</p>
							<div class="flex flex-wrap gap-2">
								for _, t := range card.RedTeams {
									<span class={ "text-sm font-black px-2 py-1 rounded-lg",
										templ.KV("bg-red-500 text-white", t == ourTeam),
										templ.KV("bg-red-100 text-red-800", t != ourTeam) }>
										{ t }
									</span>
								}
							</div>
						</div>
						<div class="rounded-[var(--ps-radius-md)] p-3 border-2 bg-blue-50 border-blue-300">
							<p class="text-xs font-bold text-blue-600 mb-2">Blue alliance</p>
							<div class="flex flex-wrap gap-2">
								for _, t := range card.BlueTeams {
									<span class={ "text-sm font-black px-2 py-1 rounded-lg",
										templ.KV("bg-blue-500 text-white", t == ourTeam),
										templ.KV("bg-blue-100 text-blue-800", t != ourTeam) }>
										{ t }
									</span>
								}
							</div>
						</div>
					</div>

					<!-- Strategy -->
					<div class="ps-panel p-4">
						<p class="text-xs font-bold text-[var(--ps-muted)] mb-2">Strategy</p>
						@StrategyBody(card.Strategy)
					</div>
				</div>
			}
		</div>
	}
}

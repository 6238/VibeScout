package templates

import "strconv"

// VideoScoutPage is the team picker: search or tap a team number, then go
// review it. Mirrors the pit scouting picker's search+grid pattern, minus
// the pit map, since video review isn't tied to a physical location.
templ VideoScoutPage(eventKey, eventName string) {
	@Layout("Vibe Scout | Video Scouting") {
		<main class="flex flex-col items-center justify-center min-h-screen px-3 py-6">
			<div class="ps-card w-full max-w-md p-6 text-center">
				<h1 class="text-xl font-extrabold text-[var(--ps-ink)] mb-1 tracking-tight">Video scouting</h1>
				<p class="text-sm font-medium text-[var(--ps-muted)] mb-4">{ eventName }</p>
				<div class="text-left mb-4">
					<label for="video-team-number" class="ps-label">Team number</label>
					<div class="relative">
						<input
							id="video-team-number"
							type="text"
							inputmode="numeric"
							pattern="[0-9]+"
							placeholder="Search a team number"
							autocomplete="off"
							class="ps-field font-data font-semibold"
						/>
						<ul id="video-team-suggest" class="hidden absolute z-10 left-0 right-0 mt-1 max-h-64 overflow-y-auto bg-[var(--ps-input)] border border-[var(--ps-border)] rounded-lg shadow-lg"></ul>
					</div>
				</div>
				<div
					id="video-teams"
					hx-get={ "/api/video-scout-teams?event_key=" + eventKey }
					hx-trigger="load"
					hx-swap="innerHTML"
				>
					<p class="text-sm text-[var(--ps-muted)]">Loading teams…</p>
				</div>
			</div>
			<div class="mt-4 text-center">
				<a href={ templ.SafeURL("/?event_key=" + eventKey) } class="btn btn-ghost btn-sm">
					@iconHome("w-4 h-4")
					Home
				</a>
			</div>
			<script>
				(function() {
					var teams = document.getElementById('video-teams');
					var input = document.getElementById('video-team-number');
					var suggest = document.getElementById('video-team-suggest');

					function closeSuggest() {
						suggest.classList.add('hidden');
						suggest.innerHTML = '';
					}

					function goToTeam(team) {
						if (!team) return;
						var link = teams.querySelector('[data-pit-team="' + team + '"]');
						if (link) { window.location.href = link.getAttribute('href'); }
					}

					input.addEventListener('input', function() {
						var q = input.value.trim();
						if (q === '') { closeSuggest(); return; }
						var all = Array.prototype.slice.call(teams.querySelectorAll('[data-pit-team]'));
						var starts = all.filter(function(el) { return el.dataset.pitTeam.indexOf(q) === 0; });
						var contains = all.filter(function(el) { return el.dataset.pitTeam.indexOf(q) > 0; });
						var list = starts.concat(contains).slice(0, 8);
						if (list.length === 0) { closeSuggest(); return; }
						suggest.innerHTML = '';
						list.forEach(function(el) {
							var li = document.createElement('li');
							li.setAttribute('role', 'option');
							li.className = 'px-3 py-2 cursor-pointer font-semibold text-[var(--ps-ink)] hover:bg-[var(--ps-gold-pale)]';
							li.textContent = el.dataset.pitTeam;
							li.addEventListener('click', function() { goToTeam(el.dataset.pitTeam); });
							suggest.appendChild(li);
						});
						suggest.classList.remove('hidden');
					});
					input.addEventListener('keydown', function(e) {
						if (e.key === 'Enter') {
							e.preventDefault();
							var first = suggest.querySelector('li');
							goToTeam(first ? first.textContent : input.value.trim());
						}
					});
					document.addEventListener('click', function(e) {
						if (e.target !== input) { closeSuggest(); }
					});
				})();
			</script>
		</main>
	}
}

// VideoScoutTeamList is the team grid loaded into the picker above. A plain
// link per team (no JS pick-handling needed) — tapping one just navigates
// straight to that team's review page.
templ VideoScoutTeamList(eventKey string, teams []PitTeam, errMsg string) {
	if errMsg != "" {
		<p class="text-sm text-red-700">{ errMsg }</p>
	} else if len(teams) == 0 {
		<p class="text-sm text-[var(--ps-muted)]">No teams listed for this event yet.</p>
	} else {
		<div class="flex flex-wrap gap-2 justify-center">
			for _, t := range teams {
				@videoTeamButton(eventKey, t)
			}
		</div>
	}
}

templ videoTeamButton(eventKey string, t PitTeam) {
	<a
		href={ templ.SafeURL("/video-scout/review?event_key=" + eventKey + "&team_number=" + t.Number) }
		data-pit-team={ t.Number }
		class={ "px-4 py-3 rounded-[var(--ps-radius-sm)] text-base font-semibold border transition inline-block",
			templ.KV("bg-[var(--ps-gold-pale)] border-[var(--ps-gold-strong)] text-[var(--ps-ink)]", t.Scouted),
			templ.KV("bg-[var(--ps-input)] border-[var(--ps-border)] text-[var(--ps-ink)] hover:border-[var(--ps-ink-soft)]", !t.Scouted) }
	>
		{ t.Number }
	</a>
}

// VideoScoutReviewPage is the main review screen for one team: every
// qualification match it played (with a link to go watch it), a click-to-open
// quick note per match, and the four big structured categories.
templ VideoScoutReviewPage(data VideoScoutReviewData) {
	@Layout("Vibe Scout | Video Scouting") {
		<main class="max-w-3xl mx-auto p-3 pb-10">
			<div class="ps-card p-5 mb-4">
				<div class="flex justify-between items-baseline gap-2 flex-wrap">
					<div>
						<h1 class="text-xl font-extrabold text-[var(--ps-ink)]">Team { data.TeamNumber }</h1>
						<p class="text-sm font-medium text-[var(--ps-muted)]">{ data.EventName } — video scouting</p>
					</div>
					<a href={ templ.SafeURL("/video-scout?event_key=" + data.EventKey) } class="btn btn-ghost btn-sm">
						@iconVideo("w-4 h-4")
						Switch team
					</a>
				</div>
			</div>
			<div class="ps-card p-5 mb-4">
				<h2 class="text-sm font-bold text-[var(--ps-muted)] mb-3">Matches</h2>
				if len(data.Matches) == 0 {
					<p class="text-sm text-[var(--ps-muted)] italic">No qualification matches found for this team yet.</p>
				} else {
					<div class="space-y-2">
						for _, m := range data.Matches {
							@videoMatchRow(m)
						}
					</div>
				}
			</div>
			<div class="ps-card p-5">
				<h2 class="text-sm font-bold text-[var(--ps-muted)] mb-1">Review notes</h2>
				if len(data.Matches) > 0 {
					<p class="text-xs text-[var(--ps-muted)] mb-3">Write one continuous account per category below. To tie a specific line to a match, select it and tap that match's pill — no need to repeat yourself in a separate box per match.</p>
				}
				<form id="video-notes-form" class="space-y-4">
					<input type="hidden" name="event_key" value={ data.EventKey }/>
					<input type="hidden" name="team_number" value={ data.TeamNumber }/>
					@videoNoteField("shooting", "Shooting", "Accuracy, cycle speed, volume over the whole match...", data.Notes.Shooting, data.Matches)
					@videoNoteField("driving", "Driving", "Field awareness, defense played or taken, positioning...", data.Notes.Driving, data.Matches)
					@videoNoteField("auto", "Auto", "What they actually do during the autonomous period...", data.Notes.Auto, data.Matches)
					@videoNoteField("failures", "Failures", "Breakdowns, technical issues, how often and when...", data.Notes.Failures, data.Matches)
					<button type="submit" id="video-save-btn" class="btn btn-primary btn-block">
						@iconVideo("w-4 h-4")
						<span id="video-save-label">Save review</span>
					</button>
				</form>
			</div>
		</main>
		<script>
			(function() {
				var form = document.getElementById('video-notes-form');
				var btn = document.getElementById('video-save-btn');
				var label = document.getElementById('video-save-label');

				function currentContext() {
					return { event_key: form.event_key.value, team_number: form.team_number.value };
				}

				form.addEventListener('submit', function(e) {
					e.preventDefault();
					var ctx = currentContext();
					window.offlineSync.queue('video-scout', '/api/save-video-scout', {
						event_key: ctx.event_key,
						team_number: ctx.team_number,
						shooting: form.shooting.value,
						driving: form.driving.value,
						auto: form.auto.value,
						failures: form.failures.value
					}, 'form');
					btn.classList.remove('btn-saved');
					void btn.offsetWidth;
					btn.classList.add('btn-saved');
					label.textContent = 'Saved';
					setTimeout(function() {
						btn.classList.remove('btn-saved');
						label.textContent = 'Save review';
					}, 900);
				});

				document.querySelectorAll('[data-quickbox-toggle]').forEach(function(toggle) {
					toggle.addEventListener('click', function() {
						var card = toggle.closest('[data-match-card]');
						var editor = card.querySelector('[data-quickbox-editor]');
						var opening = editor.classList.contains('hidden');
						editor.classList.toggle('hidden');
						if (opening) { editor.querySelector('textarea').focus(); }
					});
				});

				// Reflects a match's note text into its card (the toggle preview
				// and the manual editor textarea) without a page reload. Shared by
				// the manual "Save note" button below and the tag pills further
				// down, since both end up changing the same underlying note.
				function applyMatchNote(matchNum, note) {
					var card = document.querySelector('[data-match-card][data-match="' + matchNum + '"]');
					if (!card) return;
					card.querySelector('[data-quickbox-editor] textarea').value = note;
					var toggle = card.querySelector('[data-quickbox-toggle]');
					if (note.trim() === '') {
						toggle.textContent = '+ Add a quick note for this match';
						toggle.classList.remove('bg-[var(--ps-gold-pale)]', 'border-[var(--ps-gold-strong)]', 'text-[var(--ps-ink)]');
						toggle.classList.add('bg-[var(--ps-input)]', 'border-[var(--ps-border)]', 'text-[var(--ps-muted)]');
					} else {
						toggle.textContent = note;
						toggle.classList.remove('bg-[var(--ps-input)]', 'border-[var(--ps-border)]', 'text-[var(--ps-muted)]');
						toggle.classList.add('bg-[var(--ps-gold-pale)]', 'border-[var(--ps-gold-strong)]', 'text-[var(--ps-ink)]');
					}
				}

				function saveMatchNote(matchNum, note) {
					var ctx = currentContext();
					window.offlineSync.queue('video-scout-match', '/api/save-video-scout-match-note', {
						event_key: ctx.event_key,
						team_number: ctx.team_number,
						match_num: matchNum,
						note: note
					}, 'form');
					applyMatchNote(matchNum, note);
				}

				document.querySelectorAll('[data-quickbox-save]').forEach(function(saveBtn) {
					saveBtn.addEventListener('click', function() {
						var card = saveBtn.closest('[data-match-card]');
						var textarea = card.querySelector('[data-quickbox-editor] textarea');
						saveMatchNote(card.getAttribute('data-match'), textarea.value.trim());
						card.querySelector('[data-quickbox-editor]').classList.add('hidden');
					});
				});

				// ── Tag pills ──
				// A scouter writes one continuous account per category (Shooting,
				// Driving, ...) while watching match after match, rather than
				// breaking off to a separate box per match. To still flag a
				// specific line as being about one match, they select it and tap
				// that match's pill: the selection is copied (not cut - the
				// category box stays whole) onto that match's quick note, labeled
				// by which category it came from, so the AI can tell "[Shooting]
				// missed 3 from the far side" apart from "[Auto] left the line".
				var categoryLabels = { shooting: 'Shooting', driving: 'Driving', auto: 'Auto', failures: 'Failures' };
				Object.keys(categoryLabels).forEach(function(cat) {
					var textarea = document.getElementById('video-' + cat);
					var pillRow = document.querySelector('[data-tag-pills="' + cat + '"]');
					if (!textarea || !pillRow) return;

					pillRow.querySelectorAll('[data-tag-match]').forEach(function(pill) {
						// A plain click focuses the button first, which collapses
						// the textarea's selection before the click handler ever
						// runs. Suppressing that default on mousedown keeps focus
						// (and the selection) on the textarea instead.
						pill.addEventListener('mousedown', function(e) { e.preventDefault(); });

						pill.addEventListener('click', function() {
							var snippet = textarea.value.substring(textarea.selectionStart, textarea.selectionEnd).trim();
							var original = pill.textContent;
							pill.classList.remove('ps-chip-pop');
							void pill.offsetWidth; // restart the animation on back-to-back taps

							if (!snippet) {
								pill.textContent = 'Select text first';
								pill.classList.add('ps-chip-pop');
								setTimeout(function() { pill.textContent = original; pill.classList.remove('ps-chip-pop'); }, 1100);
								return;
							}

							var matchNum = pill.getAttribute('data-tag-match');
							var card = document.querySelector('[data-match-card][data-match="' + matchNum + '"]');
							var existing = card ? card.querySelector('[data-quickbox-editor] textarea').value.trim() : '';
							var line = '[' + categoryLabels[cat] + '] ' + snippet;
							saveMatchNote(matchNum, existing ? existing + '\n' + line : line);

							pill.classList.add('ps-chip-pop', 'ps-chip-gold');
							pill.textContent = 'Added ✓';
							setTimeout(function() { pill.textContent = original; pill.classList.remove('ps-chip-pop'); }, 900);
						});
					});
				});
			})();
		</script>
	}
}

templ videoMatchRow(m VideoScoutMatchRow) {
	<div class="ps-panel px-4 py-3" data-match-card data-match={ strconv.Itoa(m.MatchNum) }>
		<div class="flex justify-between items-baseline gap-2 flex-wrap">
			<span class="text-sm font-bold text-[var(--ps-ink)]">Match { m.Label }</span>
			<div class="flex items-center gap-2 text-xs font-semibold text-[var(--ps-ink-soft)]">
				if m.ScoreText != "" {
					<span>{ m.ScoreText }</span>
				}
				if m.Partners != "" {
					<span class="text-[var(--ps-muted)]">with { m.Partners }</span>
				}
				if m.Opponents != "" {
					<span class="text-[var(--ps-muted)]">vs { m.Opponents }</span>
				}
				if m.HasWatch {
					<a
						href={ templ.SafeURL(m.WatchURL) }
						target="_blank"
						rel="noopener"
						class="text-[var(--ps-ink)] bg-white border border-[var(--ps-border)] rounded-full px-2 py-0.5 hover:bg-[var(--ps-input)]"
					>
						▶ Watch
					</a>
				}
			</div>
		</div>
		<button
			type="button"
			data-quickbox-toggle
			class={ "mt-2 text-left w-full text-sm rounded-[var(--ps-radius-sm)] px-3 py-1.5 border transition",
				templ.KV("bg-[var(--ps-gold-pale)] border-[var(--ps-gold-strong)] text-[var(--ps-ink)]", m.HasNote),
				templ.KV("bg-[var(--ps-input)] border-[var(--ps-border)] text-[var(--ps-muted)]", !m.HasNote) }
		>
			if m.HasNote {
				{ m.Note }
			} else {
				+ Add a quick note for this match
			}
		</button>
		<div class="hidden mt-2 flex flex-col gap-2" data-quickbox-editor>
			<textarea rows="2" class="ps-field text-sm resize-none" placeholder={ "In match " + m.Label + "..." }>{ m.Note }</textarea>
			<div class="flex justify-end">
				<button type="button" data-quickbox-save class="btn btn-primary btn-sm">Save note</button>
			</div>
		</div>
	</div>
}

templ videoNoteField(name, label, placeholder, value string, matches []VideoScoutMatchRow) {
	<div class="text-left">
		<label for={ "video-" + name } class="ps-label">{ label }</label>
		<textarea id={ "video-" + name } name={ name } rows="5" class="ps-field" placeholder={ placeholder }>{ value }</textarea>
		if len(matches) > 0 {
			<div class="mt-1.5 flex flex-wrap items-center gap-1.5" data-tag-pills={ name }>
				<span class="text-xs text-[var(--ps-muted)] mr-0.5">Tag selection to:</span>
				for _, m := range matches {
					<button
						type="button"
						class={ "ps-chip ps-chip-tag", templ.KV("ps-chip-gold", m.HasNote) }
						data-tag-match={ strconv.Itoa(m.MatchNum) }
					>
						{ m.Label }
					</button>
				}
			</div>
		}
	</div>
}

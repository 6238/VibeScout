# Gemini API key — required for AI analysis, match planning, and voice notes
# (gemini-3.5-transcribe-live + gemini-3.1-flash-lite-preview)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The Blue Alliance API key — required for match schedules and event data
# Get one at https://www.thebluealliance.com/account
TBA_API_KEY=your_tba_api_key_here

# YouTube Data API v3 key — optional. Lets "Latest Matches" on team cards add a
# ▶ link straight to the moment a match happened in the event's YouTube
# livestream, so you don't have to wait for the edited match video to be
# posted. Only works for events webcast on YouTube; without this key the ▶
# link is simply not shown.
# Create a free key (no OAuth needed) at https://console.cloud.google.com/apis/credentials
# after enabling "YouTube Data API v3" on the project.
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Railway volume mount path — set automatically by Railway in production
# Leave unset for local development (uses ./vibe_scout.db)
# RAILWAY_VOLUME_MOUNT_PATH=/data
